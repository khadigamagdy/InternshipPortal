@model InternshipPortal.Models.ViewModels.ComplianceReportViewModel

@{
    ViewData["Title"] = "University Compliance Reports";
}

<style>
    .compliance-page {
        min-height: 100vh;
        padding: 42px 0 70px;
        background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.13), transparent 34%), radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.12), transparent 35%), #f8fafc;
    }

    .compliance-hero {
        position: relative;
        overflow: hidden;
        padding: 40px;
        margin-bottom: 23px;
        color: white;
        border-radius: 29px;
        background: linear-gradient(135deg, #172554, #1d4ed8 52%, #059669);
        box-shadow: 0 23px 52px rgba(30, 41, 59, 0.22);
        animation: complianceEntrance 0.7s ease;
    }

        .compliance-hero::before,
        .compliance-hero::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50%;
        }

        .compliance-hero::before {
            width: 320px;
            height: 320px;
            top: -175px;
            right: -65px;
        }

        .compliance-hero::after {
            width: 200px;
            height: 200px;
            right: 75px;
            bottom: -145px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .hero-title {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .hero-icon {
        min-width: 67px;
        height: 67px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.16);
    }

    .compliance-hero h1 {
        margin: 0;
        font-size: 33px;
        font-weight: 900;
    }

    .compliance-hero p {
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.78);
    }

    .official-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        color: #d1fae5;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid rgba(167, 243, 208, 0.28);
        border-radius: 24px;
        background: rgba(16, 185, 129, 0.17);
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 17px;
        margin-bottom: 23px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 36px rgba(37, 99, 235, 0.12);
        }

    .stat-icon {
        min-width: 49px;
        height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        border-radius: 15px;
    }

    .enrollment-icon {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .approved-icon {
        color: #047857;
        background: #d1fae5;
    }

    .compliant-icon {
        color: #4338ca;
        background: #e0e7ff;
    }

    .attention-icon {
        color: #b91c1c;
        background: #fee2e2;
    }

    .stat-number {
        display: block;
        color: #172554;
        font-size: 25px;
        font-weight: 900;
    }

    .stat-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
    }

    .control-panel {
        padding: 25px;
        margin-bottom: 23px;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: white;
        box-shadow: 0 11px 31px rgba(15, 23, 42, 0.055);
    }

    .panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 19px;
    }

        .panel-heading h2 {
            margin: 0;
            color: #172554;
            font-size: 19px;
            font-weight: 900;
        }

        .panel-heading p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

    .report-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .report-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 14px;
        font-size: 11px;
        font-weight: 900;
        border: none;
        border-radius: 11px;
        text-decoration: none;
        transition: 0.3s;
    }

    .print-button {
        color: #4338ca;
        background: #eef2ff;
    }

    .export-button {
        color: #047857;
        background: #d1fae5;
    }

    .report-button:hover {
        color: white;
        transform: translateY(-3px);
    }

    .print-button:hover {
        background: #4f46e5;
    }

    .export-button:hover {
        background: #059669;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 13px;
        align-items: end;
    }

    .filter-label {
        margin-bottom: 7px;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
    }

    .filter-input {
        min-height: 48px;
        padding: 10px 13px;
        color: #334155;
        font-size: 12px;
        border: 1px solid #dbe3ee;
        border-radius: 12px;
        background: #fbfdff;
        transition: 0.3s;
    }

        .filter-input:focus {
            border-color: #60a5fa;
            background: white;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        }

    .filter-buttons {
        display: flex;
        gap: 8px;
    }

    .search-button {
        min-height: 48px;
        padding: 10px 16px;
        color: white;
        font-size: 11px;
        font-weight: 900;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #2563eb, #0ea5e9);
        transition: 0.3s;
    }

    .reset-button {
        min-height: 48px;
        display: flex;
        align-items: center;
        padding: 10px 13px;
        color: #475569;
        border-radius: 12px;
        background: #f1f5f9;
        text-decoration: none;
        transition: 0.3s;
    }

        .search-button:hover,
        .reset-button:hover {
            transform: translateY(-3px);
        }

    .compliance-overview {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 20px;
        margin-bottom: 23px;
    }

    .progress-card,
    .records-card {
        padding: 26px;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: white;
        box-shadow: 0 11px 31px rgba(15, 23, 42, 0.055);
    }

    .progress-card {
        text-align: center;
    }

    .compliance-ring {
        --rate: 0;
        width: 155px;
        height: 155px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 15px auto;
        color: #1d4ed8;
        font-size: 27px;
        font-weight: 900;
        border-radius: 50%;
        background: radial-gradient(closest-side, white 72%, transparent 75%), conic-gradient( #2563eb calc(var(--rate) * 1%), #e2e8f0 0);
    }

    .progress-card h3 {
        margin: 0;
        color: #172554;
        font-size: 18px;
        font-weight: 900;
    }

    .progress-card p {
        margin: 6px 0 0;
        color: #94a3b8;
        font-size: 11px;
    }

    .hours-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-top: 18px;
    }

    .hours-box {
        padding: 11px;
        border-radius: 12px;
        background: #f8fafc;
    }

        .hours-box strong,
        .hours-box span {
            display: block;
        }

        .hours-box strong {
            color: #172554;
            font-size: 16px;
        }

        .hours-box span {
            margin-top: 3px;
            color: #94a3b8;
            font-size: 9px;
        }

    .records-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 19px;
    }

        .records-heading h2 {
            margin: 0;
            color: #172554;
            font-size: 19px;
            font-weight: 900;
        }

    .results-count {
        padding: 6px 10px;
        color: #1d4ed8;
        font-size: 10px;
        font-weight: 900;
        border-radius: 18px;
        background: #dbeafe;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .compliance-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .compliance-table th {
            padding: 12px 10px;
            color: #64748b;
            font-size: 9px;
            font-weight: 900;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
            text-transform: uppercase;
        }

        .compliance-table td {
            padding: 14px 10px;
            color: #475569;
            font-size: 10px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .compliance-table tbody tr {
            transition: 0.25s;
        }

            .compliance-table tbody tr:hover {
                background: #f8fbff;
            }

    .student-name {
        display: block;
        color: #172554;
        font-size: 11px;
        font-weight: 900;
    }

    .student-specialization {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 8px;
    }

    .training-name {
        display: block;
        color: #334155;
        font-weight: 800;
    }

    .company-name {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 8px;
    }

    .hours-progress {
        width: 110px;
    }

    .hours-progress-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 8px;
        font-weight: 800;
    }

    .hours-track {
        height: 6px;
        overflow: hidden;
        border-radius: 10px;
        background: #e2e8f0;
    }

        .hours-track span {
            display: block;
            height: 100%;
            min-width: 4px;
            border-radius: 10px;
            background: linear-gradient(90deg, #2563eb, #10b981);
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        font-size: 8px;
        font-weight: 900;
        border-radius: 18px;
        white-space: nowrap;
    }

    .status-compliant {
        color: #047857;
        background: #d1fae5;
    }

    .status-on-track {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-attention {
        color: #b45309;
        background: #fef3c7;
    }

    .status-overdue {
        color: #b91c1c;
        background: #fee2e2;
    }

    .status-pending {
        color: #6d28d9;
        background: #ede9fe;
    }

    .score-circle {
        --score: 0;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1d4ed8;
        font-size: 9px;
        font-weight: 900;
        border-radius: 50%;
        background: radial-gradient(closest-side, white 70%, transparent 74%), conic-gradient( #2563eb calc(var(--score) * 1%), #e2e8f0 0);
    }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
        border: 2px dashed #cbd5e1;
        border-radius: 19px;
        background: #f8fafc;
    }

        .empty-state span {
            font-size: 63px;
        }

        .empty-state h3 {
            margin: 15px 0 5px;
            color: #172554;
            font-weight: 900;
        }

        .empty-state p {
            color: #64748b;
        }

    @@keyframes complianceEntrance {
        from {
            opacity: 0;
            transform: translateY(23px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1100px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .filter-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .compliance-overview {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .hero-content,
        .hero-title,
        .panel-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .compliance-hero {
            padding: 29px 22px;
        }

            .compliance-hero h1 {
                font-size: 27px;
            }
    }

    @@media (max-width: 576px) {
        .statistics-grid,
        .filter-grid {
            grid-template-columns: 1fr;
        }

        .filter-buttons {
            flex-direction: column;
        }

        .search-button,
        .reset-button {
            justify-content: center;
        }
    }
</style>

<div class="compliance-page">
    <div class="container">
        <section class="compliance-hero">
            <div class="hero-content">
                <div class="hero-title">
                    <div class="hero-icon">
                        <i class="bi bi-clipboard2-data-fill"></i>
                    </div>

                    <div>
                        <h1>University Compliance Reports</h1>

                        <p>
                            Monitor approvals, verified hours,
                            weekly reports and training completion.
                        </p>
                    </div>
                </div>

                <span class="official-badge">
                    <i class="bi bi-shield-check"></i>
                    Official Training Records
                </span>
            </div>
        </section>

        <section class="statistics-grid">
            <div class="stat-card">
                <div class="stat-icon enrollment-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <span class="stat-number">
                        @Model.TotalEnrollments
                    </span>

                    <span class="stat-label">
                        Training Enrollments
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon approved-icon">
                    <i class="bi bi-building-check"></i>
                </div>

                <div>
                    <span class="stat-number">
                        @Model.UniversityApproved
                    </span>

                    <span class="stat-label">
                        University Approved
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon compliant-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div>
                    <span class="stat-number">
                        @Model.FullyCompliant
                    </span>

                    <span class="stat-label">
                        Fully Compliant
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon attention-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <span class="stat-number">
                        @Model.NeedsAttention
                    </span>

                    <span class="stat-label">
                        Needs Attention
                    </span>
                </div>
            </div>
        </section>

        <section class="control-panel">
            <div class="panel-heading">
                <div>
                    <h2>Report Controls</h2>
                    <p>Filter records or generate an official report</p>
                </div>

                <div class="report-actions">
                    <a asp-action="Print"
                       asp-route-search="@Model.Search"
                       asp-route-university="@Model.University"
                       asp-route-complianceStatus="@Model.ComplianceStatus"
                       target="_blank"
                       class="report-button print-button">
                        <i class="bi bi-printer-fill"></i>
                        Print Official Report
                    </a>

                    <a asp-action="ExportCsv"
                       asp-route-search="@Model.Search"
                       asp-route-university="@Model.University"
                       asp-route-complianceStatus="@Model.ComplianceStatus"
                       class="report-button export-button">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                        Export CSV
                    </a>
                </div>
            </div>

            <form asp-action="Index"
                  method="get"
                  class="filter-grid">

                <div>
                    <label asp-for="Search"
                           class="filter-label">
                    </label>

                    <input asp-for="Search"
                           class="form-control filter-input"
                           placeholder="Student, internship, company or specialization..." />
                </div>

                <div>
                    <label asp-for="University"
                           class="filter-label">
                    </label>

                    <select asp-for="University"
                            class="form-select filter-input">
                        <option value="">All Universities</option>

                        @foreach (var university in
                                                Model.AvailableUniversities)
                        {
                            <option value="@university">
                                @university
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="ComplianceStatus"
                           class="filter-label">
                    </label>

                    <select asp-for="ComplianceStatus"
                            class="form-select filter-input">
                        <option value="">All Statuses</option>
                        <option value="Compliant">Compliant</option>
                        <option value="On Track">On Track</option>
                        <option value="Needs Attention">Needs Attention</option>
                        <option value="Overdue">Overdue</option>
                        <option value="Pending Approval">Pending Approval</option>
                    </select>
                </div>

                <div class="filter-buttons">
                    <button type="submit"
                            class="search-button">
                        <i class="bi bi-search me-1"></i>
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="reset-button"
                       title="Reset filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </section>

        <section class="compliance-overview">
            <aside class="progress-card">
                <h3>Overall Hours Compliance</h3>

                <p>Approved hours compared with required hours</p>

                <div class="compliance-ring"
                     style="--rate: @Model.OverallComplianceRate">
                    @Model.OverallComplianceRate.ToString("0.0")%
                </div>

                <div class="hours-summary">
                    <div class="hours-box">
                        <strong>
                            @Model.TotalRequiredHours
                        </strong>

                        <span>Required Hours</span>
                    </div>

                    <div class="hours-box">
                        <strong>
                            @Model.TotalApprovedHours.ToString("0.##")
                        </strong>

                        <span>Approved Hours</span>
                    </div>
                </div>
            </aside>

            <div class="records-card">
                <div class="records-heading">
                    <div>
                        <h2>Student Compliance Records</h2>
                    </div>

                    <span class="results-count">
                        @Model.Students.Count record(s)
                    </span>
                </div>

                @if (Model.Students.Any())
                {
                    <div class="table-wrapper">
                        <table class="compliance-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>University</th>
                                    <th>Training</th>
                                    <th>Dates</th>
                                    <th>Approved Hours</th>
                                    <th>Reports</th>
                                    <th>Approval</th>
                                    <th>Status</th>
                                    <th>Score</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var student in Model.Students)
                                {
                                    var statusClass =
                                    student.ComplianceStatus switch
                                    {
                                        "Compliant" =>
                                                            "status-compliant",

                                        "On Track" =>
                                                            "status-on-track",

                                        "Overdue" =>
                                                            "status-overdue",

                                        "Pending Approval" =>
                                                            "status-pending",

                                        _ =>
                                                            "status-attention"
                                    };

                                    var statusIcon =
                                    student.ComplianceStatus switch
                                    {
                                        "Compliant" =>
                                                            "bi-patch-check-fill",

                                        "On Track" =>
                                                            "bi-graph-up-arrow",

                                        "Overdue" =>
                                                            "bi-clock-fill",

                                        "Pending Approval" =>
                                                            "bi-hourglass-split",

                                        _ =>
                                                            "bi-exclamation-triangle-fill"
                                    };

                                    <tr>
                                        <td>
                                            <span class="student-name">
                                                @student.StudentName
                                            </span>

                                            <span class="student-specialization">
                                                @student.Specialization
                                            </span>
                                        </td>

                                        <td>
                                            @student.University
                                        </td>

                                        <td>
                                            <span class="training-name">
                                                @student.InternshipTitle
                                            </span>

                                            <span class="company-name">
                                                @student.CompanyName
                                            </span>
                                        </td>

                                        <td>
                                            @student.StartDate.ToString("dd MMM yy")
                                            <br />
                                            <span class="text-muted">
                                                to
                                                @student.ExpectedEndDate
                                                .ToString("dd MMM yy")
                                            </span>
                                        </td>

                                        <td>
                                            <div class="hours-progress">
                                                <div class="hours-progress-top">
                                                    <span>
                                                        @student.ApprovedHours
                                                        .ToString("0.##")
                                                        /
                                                        @student.RequiredHours
                                                    </span>

                                                    <span>
                                                        @student.HoursCompletionRate
                                                        .ToString("0")%
                                                    </span>
                                                </div>

                                                <div class="hours-track">
                                                    <span style="width:
                                                                @student.HoursCompletionRate%">
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            @student.ApprovedReportsCount
                                            /
                                            @student.WeeklyReportsCount
                                            approved
                                        </td>

                                        <td>
                                            @if (student.IsUniversityApproved)
                                            {
                                                <span class="status-badge status-compliant">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Approved
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    Pending
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <span class="status-badge @statusClass">
                                                <i class="bi @statusIcon"></i>
                                                @student.ComplianceStatus
                                            </span>
                                        </td>

                                        <td>
                                            <div class="score-circle"
                                                 style="--score:
                                                            @student.ComplianceScore">
                                                @student.ComplianceScore
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span>📋</span>

                        <h3>No Compliance Records</h3>

                        <p>
                            Training records matching the selected
                            filters will appear here.
                        </p>
                    </div>
                }
            </div>
        </section>
    </div>
</div>