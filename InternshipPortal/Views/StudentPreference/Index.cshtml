@model InternshipPortal.Models.ViewModels.StudentPreferenceViewModel

@{
    ViewData["Title"] = "Career Preferences";
    var hasPreferences = ViewBag.HasPreferences == true;
}

<style>
    .preferences-page {
        min-height: 100vh;
        padding: 45px 0;
        background: radial-gradient(circle at top left, rgba(99, 102, 241, 0.14), transparent 35%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.13), transparent 35%), #f8fafc;
    }

    .preferences-header {
        position: relative;
        overflow: hidden;
        padding: 38px;
        margin-bottom: 25px;
        color: white;
        border-radius: 27px;
        background: linear-gradient(135deg, #312e81, #4f46e5, #0284c7);
        box-shadow: 0 20px 45px rgba(49, 46, 129, 0.24);
        animation: headerAppear 0.7s ease;
    }

        .preferences-header::after {
            position: absolute;
            width: 240px;
            height: 240px;
            right: -75px;
            bottom: -145px;
            content: "";
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .header-icon {
        min-width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.16);
        animation: iconFloat 3s ease-in-out infinite;
    }

    .preferences-header h1 {
        margin: 0;
        font-weight: 900;
    }

    .preferences-header p {
        max-width: 680px;
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.83);
    }

    .preferences-layout {
        display: grid;
        grid-template-columns: 330px 1fr;
        gap: 24px;
    }

    .information-card,
    .form-card {
        border: 1px solid #e2e8f0;
        border-radius: 23px;
        background: white;
        box-shadow: 0 11px 30px rgba(15, 23, 42, 0.07);
    }

    .information-card {
        align-self: start;
        padding: 28px;
        text-align: center;
    }

    .information-icon {
        width: 92px;
        height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        color: white;
        font-size: 40px;
        border-radius: 28px;
        background: linear-gradient(135deg, #6366f1, #06b6d4);
        box-shadow: 0 13px 27px rgba(99, 102, 241, 0.25);
    }

    .information-card h3 {
        margin-bottom: 5px;
        color: #0f172a;
        font-weight: 900;
    }

    .information-card > p {
        color: #64748b;
        font-size: 13px;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        margin: 8px 0 22px;
        font-size: 12px;
        font-weight: 800;
        border-radius: 20px;
    }

    .status-complete {
        color: #047857;
        background: #d1fae5;
    }

    .status-incomplete {
        color: #b45309;
        background: #fef3c7;
    }

    .benefit-list {
        padding: 20px 0 0;
        margin: 0;
        text-align: left;
        border-top: 1px solid #e2e8f0;
        list-style: none;
    }

        .benefit-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 14px;
            color: #475569;
            font-size: 13px;
        }

        .benefit-list i {
            color: #10b981;
            font-size: 16px;
        }

    .form-card {
        padding: 30px;
    }

    .form-heading {
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e2e8f0;
    }

        .form-heading h3 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
        }

        .form-heading p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 13px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 19px;
    }

    .full-field {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #1e293b;
        font-size: 13px;
        font-weight: 800;
    }

    .preference-input {
        width: 100%;
        min-height: 50px;
        padding: 12px 15px;
        color: #0f172a;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
        outline: none;
        transition: 0.3s;
    }

        .preference-input:focus {
            border-color: #6366f1;
            background: white;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    textarea.preference-input {
        min-height: 115px;
        resize: vertical;
    }

    .field-help {
        display: block;
        margin-top: 6px;
        color: #94a3b8;
        font-size: 11px;
    }

    .options-box {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
        margin-top: 4px;
    }

    .option-card {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 16px;
        cursor: pointer;
        border: 2px solid #e2e8f0;
        border-radius: 15px;
        background: #f8fafc;
        transition: 0.3s;
    }

        .option-card:hover {
            border-color: #a5b4fc;
            background: #eef2ff;
            transform: translateY(-2px);
        }

        .option-card input {
            width: 19px;
            height: 19px;
            accent-color: #4f46e5;
        }

        .option-card strong {
            display: block;
            color: #1e293b;
            font-size: 13px;
        }

        .option-card small {
            color: #64748b;
            font-size: 11px;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 27px;
        padding-top: 21px;
        border-top: 1px solid #e2e8f0;
    }

    .back-button,
    .save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        font-weight: 800;
        border-radius: 13px;
        text-decoration: none;
        transition: 0.3s;
    }

    .back-button {
        color: #475569;
        border: 1px solid #cbd5e1;
        background: white;
    }

    .save-button {
        color: white;
        border: none;
        background: linear-gradient(135deg, #4f46e5, #0284c7);
        box-shadow: 0 9px 22px rgba(79, 70, 229, 0.24);
    }

        .back-button:hover,
        .save-button:hover {
            transform: translateY(-3px);
        }

    .back-button:hover {
        color: #4f46e5;
        border-color: #a5b4fc;
    }

    .save-button:hover {
        color: white;
        box-shadow: 0 14px 28px rgba(79, 70, 229, 0.32);
    }

    @@keyframes headerAppear {
        from {
            opacity: 0;
            transform: translateY(-25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0) rotate(0);
        }

        50% {
            transform: translateY(-6px) rotate(5deg);
        }
    }

    @@media (max-width: 992px) {
        .preferences-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .form-grid,
        .options-box {
            grid-template-columns: 1fr;
        }

        .preferences-header,
        .form-card {
            padding: 24px 19px;
        }

        .form-actions {
            flex-direction: column;
        }

        .back-button,
        .save-button {
            width: 100%;
        }
    }
</style>

<div class="preferences-page">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="preferences-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <div>
                    <h1>Build Your Career Match</h1>
                    <p>
                        Tell us what you are looking for and our matching
                        system will rank internships based on your skills,
                        interests and preferences.
                    </p>
                </div>
            </div>
        </div>

        <div class="preferences-layout">
            <aside class="information-card">
                <div class="information-icon">
                    <i class="bi bi-person-heart"></i>
                </div>

                <h3>@ViewBag.StudentName</h3>
                <p>Personalized internship recommendations</p>

                @if (hasPreferences)
                {
                    <span class="profile-status status-complete">
                        <i class="bi bi-patch-check-fill"></i>
                        Preferences Completed
                    </span>
                }
                else
                {
                    <span class="profile-status status-incomplete">
                        <i class="bi bi-hourglass-split"></i>
                        Preferences Required
                    </span>
                }

                <ul class="benefit-list">
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Internships ranked by compatibility.</span>
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Clear matched and missing skills.</span>
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Recommendations based on your career goals.</span>
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Better applications with less searching.</span>
                    </li>
                </ul>
            </aside>

            <div class="form-card">
                <div class="form-heading">
                    <h3>Matching Preferences</h3>
                    <p>You can update these details at any time.</p>
                </div>

                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="form-grid">
                        <div class="form-group full-field">
                            <label asp-for="Skills"></label>

                            <textarea asp-for="Skills"
                                      class="preference-input"
                                      placeholder="C#, ASP.NET Core, SQL Server, HTML, CSS, JavaScript"></textarea>

                            <span class="field-help">
                                Separate skills using commas.
                            </span>

                            <span asp-validation-for="Skills"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-group full-field">
                            <label asp-for="CareerInterests"></label>

                            <textarea asp-for="CareerInterests"
                                      class="preference-input"
                                      placeholder="Backend development, cybersecurity, cloud computing..."></textarea>

                            <span asp-validation-for="CareerInterests"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PreferredLocation"></label>

                            <input asp-for="PreferredLocation"
                                   class="preference-input"
                                   placeholder="Mansoura, Cairo, Alexandria..." />

                            <span asp-validation-for="PreferredLocation"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PreferredWorkMode"></label>

                            <select asp-for="PreferredWorkMode"
                                    asp-items="Html.GetEnumSelectList<InternshipPortal.Models.Enums.WorkMode>()"
                                    class="preference-input">
                                <option value="">
                                    Any work mode
                                </option>
                            </select>

                            <span asp-validation-for="PreferredWorkMode"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="MinimumSalary"></label>

                            <input asp-for="MinimumSalary"
                                   type="number"
                                   min="0"
                                   step="100"
                                   class="preference-input"
                                   placeholder="Example: 3000" />

                            <span asp-validation-for="MinimumSalary"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="MaximumWeeklyHours"></label>

                            <input asp-for="MaximumWeeklyHours"
                                   type="number"
                                   min="1"
                                   max="24"
                                   class="preference-input"
                                   placeholder="Example: 20" />

                            <span asp-validation-for="MaximumWeeklyHours"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="options-box">
                            <label class="option-card">
                                <input asp-for="AcceptUnpaidInternships" />

                                <span>
                                    <strong>Accept Unpaid Internships</strong>
                                    <small>
                                        Include unpaid training opportunities.
                                    </small>
                                </span>
                            </label>

                            <label class="option-card">
                                <input asp-for="AcceptRemoteInternships" />

                                <span>
                                    <strong>Accept Remote Internships</strong>
                                    <small>
                                        Include remote work opportunities.
                                    </small>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="back-button">
                            <i class="bi bi-arrow-left"></i>
                            Dashboard
                        </a>

                        <button type="submit"
                                class="save-button">
                            <i class="bi bi-stars"></i>
                            Save & Find Matches
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}