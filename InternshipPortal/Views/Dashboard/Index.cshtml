@model InternshipPortal.Models.ViewModels.DashboardViewModel
@using InternshipPortal.Models.Enums

@{
    ViewData["Title"] = "Dashboard";

    var isAdmin = Model.AccountType == "Administrator";
    var isStudent = Model.AccountType == "Student";
    var isCompany = Model.AccountType == "Company";
}

<style>
    .dashboard-page {
        min-height: 100vh;
        padding: 35px 20px 70px;
        background: radial-gradient( circle at top left, rgba(37, 99, 235, 0.1), transparent 30%), radial-gradient( circle at bottom right, rgba(124, 58, 237, 0.09), transparent 35%), #f5f7fb;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: auto;
    }

    .dashboard-hero {
        position: relative;
        min-height: 285px;
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        align-items: center;
        overflow: hidden;
        padding: 43px 50px;
        color: white;
        border-radius: 28px;
        background: linear-gradient( 135deg, #0f2b5b, #1d4ed8 57%, #6d28d9);
        box-shadow: 0 22px 50px rgba(30, 64, 175, 0.22);
        animation: dashboardEntrance 0.7s ease;
    }

    .student-hero {
        background: linear-gradient( 135deg, #172554, #2563eb, #7c3aed);
    }

    .company-hero {
        background: linear-gradient( 135deg, #064e3b, #059669, #0ea5e9);
    }

    .admin-hero {
        background: linear-gradient( 135deg, #312e81, #4f46e5, #7c3aed);
    }

    .hero-content {
        position: relative;
        z-index: 3;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        margin-bottom: 16px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.15);
    }

    .dashboard-hero h1 {
        max-width: 720px;
        margin: 0;
        font-size: 37px;
        font-weight: 900;
    }

        .dashboard-hero h1 span {
            color: #bfdbfe;
        }

    .dashboard-hero p {
        max-width: 650px;
        margin: 13px 0 0;
        color: rgba(255, 255, 255, 0.82);
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 11px;
        margin-top: 25px;
    }

    .hero-primary,
    .hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 18px;
        font-weight: 800;
        border-radius: 12px;
        text-decoration: none;
        transition: 0.3s;
    }

    .hero-primary {
        color: #1e3a8a;
        background: white;
    }

    .hero-secondary {
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.13);
    }

        .hero-primary:hover,
        .hero-secondary:hover {
            transform: translateY(-3px);
        }

    .hero-primary:hover {
        color: #1e3a8a;
    }

    .hero-secondary:hover {
        color: white;
        background: rgba(255, 255, 255, 0.22);
    }

    .hero-visual {
        position: relative;
        min-height: 200px;
    }

    .hero-main-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 130px;
        height: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        border-radius: 37px;
        background: rgba(255, 255, 255, 0.17);
        backdrop-filter: blur(10px);
        transform: translate(-50%, -50%);
        animation: iconFloat 4s ease-in-out infinite;
    }

    .hero-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 280px;
        height: 280px;
        border: 1px solid rgba(255, 255, 255, 0.17);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    .floating-info {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 15px;
        color: #172554;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 13px 27px rgba(15, 23, 42, 0.16);
        animation: cardFloat 4s ease-in-out infinite;
    }

        .floating-info strong,
        .floating-info small {
            display: block;
        }

        .floating-info small {
            color: #64748b;
            font-size: 10px;
        }

    .floating-one {
        top: 10px;
        left: 0;
    }

    .floating-two {
        right: 0;
        bottom: 10px;
        animation-delay: 1.2s;
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 19px;
        margin-top: 25px;
    }

    .statistic-card {
        padding: 22px;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        transition: 0.35s;
        animation: dashboardEntrance 0.75s ease;
    }

        .statistic-card:hover {
            border-color: #c7d2fe;
            transform: translateY(-7px);
            box-shadow: 0 18px 37px rgba(79, 70, 229, 0.13);
        }

    .statistic-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .statistic-icon {
        width: 51px;
        height: 51px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        border-radius: 16px;
    }

    .blue-icon {
        color: #2563eb;
        background: #dbeafe;
    }

    .purple-icon {
        color: #7c3aed;
        background: #ede9fe;
    }

    .green-icon {
        color: #059669;
        background: #d1fae5;
    }

    .orange-icon {
        color: #ea580c;
        background: #ffedd5;
    }

    .pink-icon {
        color: #e11d48;
        background: #ffe4e6;
    }

    .statistic-card h2 {
        margin: 17px 0 3px;
        color: #172554;
        font-size: 31px;
        font-weight: 900;
    }

    .statistic-card p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 22px;
        margin-top: 25px;
    }

    .dashboard-card {
        padding: 25px;
        border: 1px solid #e2e8f0;
        border-radius: 21px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
    }

        .section-heading h3 {
            margin: 0;
            color: #172554;
            font-size: 19px;
            font-weight: 900;
        }

        .section-heading p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

    .view-all-link {
        color: #4f46e5;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .quick-actions-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .quick-action {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 14px;
        color: inherit;
        border: 1px solid #edf1f7;
        border-radius: 14px;
        text-decoration: none;
        transition: 0.3s;
    }

        .quick-action:hover {
            color: inherit;
            border-color: #bfdbfe;
            background: #f8faff;
            transform: translateX(5px);
        }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        border-radius: 13px;
    }

    .quick-action strong,
    .quick-action small {
        display: block;
    }

    .quick-action strong {
        color: #1e293b;
        font-size: 13px;
    }

    .quick-action small {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
    }

    .quick-arrow {
        color: #94a3b8;
        transition: 0.3s;
    }

    .quick-action:hover .quick-arrow {
        color: #4f46e5;
        transform: translateX(4px);
    }

    .application-item,
    .internship-item,
    .interview-item,
    .saved-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 13px;
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .application-item:last-child,
        .internship-item:last-child,
        .interview-item:last-child,
        .saved-item:last-child {
            border-bottom: none;
        }

    .item-information {
        min-width: 0;
    }

        .item-information strong,
        .item-information small {
            display: block;
        }

        .item-information strong {
            overflow: hidden;
            color: #1e293b;
            font-size: 13px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .item-information small {
            margin-top: 4px;
            color: #94a3b8;
            font-size: 10px;
        }

    .item-status {
        flex-shrink: 0;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 800;
        border-radius: 20px;
    }

    .pending,
    .underreview {
        color: #b45309;
        background: #fef3c7;
    }

    .interviewscheduled {
        color: #0369a1;
        background: #e0f2fe;
    }

    .accepted,
    .approved {
        color: #047857;
        background: #d1fae5;
    }

    .rejected {
        color: #b91c1c;
        background: #fee2e2;
    }

    .completed {
        color: #4338ca;
        background: #e0e7ff;
    }

    .interview-date-box {
        min-width: 53px;
        padding: 8px;
        color: white;
        text-align: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
    }

        .interview-date-box strong,
        .interview-date-box small {
            display: block;
        }

        .interview-date-box strong {
            font-size: 16px;
        }

        .interview-date-box small {
            font-size: 9px;
        }

    .empty-state {
        padding: 35px 15px;
        text-align: center;
    }

        .empty-state span {
            display: block;
            margin-bottom: 10px;
            font-size: 43px;
        }

        .empty-state h4 {
            margin: 0;
            color: #334155;
            font-size: 15px;
        }

        .empty-state p {
            margin: 6px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

    .profile-required {
        max-width: 820px;
        padding: 50px 30px;
        margin: 70px auto;
        text-align: center;
        border: 1px solid #e2e8f0;
        border-radius: 27px;
        background: white;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.1);
    }

    .profile-required-icon {
        width: 85px;
        height: 85px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 39px;
        border-radius: 25px;
        background: #e0e7ff;
        animation: iconFloatSimple 2.5s ease-in-out infinite;
    }

    .profile-required h2 {
        margin-top: 20px;
        color: #172554;
        font-weight: 900;
    }

    .profile-required p {
        color: #64748b;
    }

    .complete-profile-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        margin-top: 10px;
        color: white;
        font-weight: 800;
        border-radius: 13px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        text-decoration: none;
        transition: 0.3s;
    }

        .complete-profile-button:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(79, 70, 229, 0.28);
        }

    @@keyframes dashboardEntrance {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translate(-50%, -50%) rotate(-5deg);
        }

        50% {
            transform: translate(-50%, -58%) rotate(4deg);
        }
    }

    @@keyframes iconFloatSimple {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-7px) rotate(5deg);
        }
    }

    @@keyframes cardFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-9px);
        }
    }

    @@media (max-width: 1050px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 800px) {
        .dashboard-hero {
            grid-template-columns: 1fr;
            padding: 35px 27px;
        }

        .hero-visual {
            display: none;
        }

        .dashboard-hero h1 {
            font-size: 29px;
        }
    }

    @@media (max-width: 576px) {
        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-primary,
        .hero-secondary {
            justify-content: center;
        }
    }
</style>

<div class="dashboard-page">
    <div class="dashboard-container">

        @if (!Model.ProfileCompleted)
        {
            <div class="profile-required">
                <div class="profile-required-icon">
                    @(isStudent ? "🎓" : "🏢")
                </div>

                <h2>Complete Your Profile</h2>

                <p>
                    Your @Model.AccountType.ToLower() account is ready,
                    but some required profile information is still missing.
                </p>

                @if (isStudent)
                {
                    <a asp-controller="Student"
                       asp-action="Profile"
                       class="complete-profile-button">
                        <i class="bi bi-person-lines-fill"></i>
                        Complete Student Profile
                    </a>
                }
                else
                {
                    <a asp-controller="Company"
                       asp-action="Profile"
                       class="complete-profile-button">
                        <i class="bi bi-building-fill"></i>
                        Complete Company Profile
                    </a>
                }
            </div>
        }
        else
        {
            <section class="dashboard-hero
                @(isStudent
                    ? "student-hero"
                    : isCompany
                        ? "company-hero"
                        : "admin-hero")">

                <div class="hero-content">
                    <span class="hero-badge">
                        @if (isStudent)
                        {
                            <i class="bi bi-mortarboard-fill"></i>
                        }
                        else if (isCompany)
                        {
                            <i class="bi bi-building-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-shield-lock-fill"></i>
                        }

                        @Model.AccountType Dashboard
                    </span>

                    <h1>
                        Welcome back,
                        <span>@Model.DisplayName</span>
                    </h1>

                    @if (isStudent)
                    {
                        <p>
                            Explore verified internships, track your applications
                            and manage upcoming interview invitations.
                        </p>

                        <div class="hero-actions">
                            <a asp-controller="Internship"
                               asp-action="Index"
                               class="hero-primary">
                                <i class="bi bi-search"></i>
                                Browse Internships
                            </a>

                            <a asp-controller="Interview"
                               asp-action="MyInterviews"
                               class="hero-secondary">
                                <i class="bi bi-calendar2-check-fill"></i>
                                My Interviews
                            </a>
                        </div>
                    }
                    else if (isCompany)
                    {
                        <p>
                            Publish internship opportunities, review candidates
                            and manage the complete interview process.
                        </p>

                        <div class="hero-actions">
                            <a asp-controller="Internship"
                               asp-action="Create"
                               class="hero-primary">
                                <i class="bi bi-plus-circle-fill"></i>
                                Add Internship
                            </a>

                            <a asp-controller="Internship"
                               asp-action="MyInternships"
                               class="hero-secondary">
                                <i class="bi bi-briefcase-fill"></i>
                                My Internships
                            </a>
                        </div>
                    }
                    else
                    {
                        <p>
                            Monitor portal activity, approve opportunities
                            and manage students and companies.
                        </p>

                        <div class="hero-actions">
                            <a asp-controller="Admin"
                               asp-action="PendingInternships"
                               class="hero-primary">
                                <i class="bi bi-hourglass-split"></i>
                                Review Internships
                            </a>

                            <a asp-controller="UserManagement"
                               asp-action="Index"
                               class="hero-secondary">
                                <i class="bi bi-people-fill"></i>
                                Manage Users
                            </a>
                        </div>
                    }
                </div>

                <div class="hero-visual">
                    <div class="hero-circle"></div>

                    <div class="hero-main-icon">
                        @(isStudent
                            ? "🎓"
                            : isCompany
                                ? "🏢"
                                : "📊")
                    </div>

                    <div class="floating-info floating-one">
                        <span>📅</span>

                        <div>
                            <strong>
                                @(isStudent
                                    ? Model.StudentUpcomingInterviews
                                    : isCompany
                                        ? Model.CompanyUpcomingInterviews
                                        : Model.PendingApplications)
                            </strong>

                            <small>
                                @(isAdmin
                                    ? "Pending Applications"
                                    : "Upcoming Interviews")
                            </small>
                        </div>
                    </div>

                    <div class="floating-info floating-two">
                        <span>🚀</span>

                        <div>
                            <strong>
                                @(isStudent
                                    ? Model.ApprovedInternships
                                    : isCompany
                                        ? Model.CompanyInternships
                                        : Model.ApprovedInternships)
                            </strong>

                            <small>
                                @(isCompany
                                    ? "My Opportunities"
                                    : "Available Opportunities")
                            </small>
                        </div>
                    </div>
                </div>
            </section>

            @if (isStudent)
            {
                <section class="statistics-grid">
                    <div class="statistic-card">
                        <div class="statistic-top">
                            <div class="statistic-icon blue-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                        </div>

                        <h2>@Model.StudentApplications</h2>
                        <p>My applications</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-top">
                            <div class="statistic-icon orange-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>

                        <h2>@Model.StudentPendingApplications</h2>
                        <p>Applications in progress</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-top">
                            <div class="statistic-icon green-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </div>

                        <h2>@Model.StudentAcceptedApplications</h2>
                        <p>Accepted applications</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-top">
                            <div class="statistic-icon purple-icon">
                                <i class="bi bi-calendar2-check-fill"></i>
                            </div>
                        </div>

                        <h2>@Model.StudentUpcomingInterviews</h2>
                        <p>Upcoming interviews</p>
                    </div>
                </section>

                <section class="dashboard-grid">
                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>My Recent Applications</h3>
                                <p>Track your latest application updates</p>
                            </div>

                            <a asp-controller="Application"
                               asp-action="MyApplications"
                               class="view-all-link">
                                View All
                            </a>
                        </div>

                        @if (Model.RecentApplications.Any())
                        {
                            @foreach (var application in Model.RecentApplications)
                            {
                                var statusClass =
                                    application.Status
                                        .ToString()
                                        .ToLowerInvariant();

                                <div class="application-item">
                                    <div class="item-information">
                                        <strong>
                                            @application.Internship.Title
                                        </strong>

                                        <small>
                                            @application.Internship.Company.Name
                                            · Applied
                                            @application.AppliedAt.ToString("dd MMM yyyy")
                                        </small>
                                    </div>

                                    <span class="item-status @statusClass">
                                        @application.Status
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>📄</span>
                                <h4>No applications yet</h4>
                                <p>Apply for an internship to start tracking progress.</p>
                            </div>
                        }
                    </div>

                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Quick Actions</h3>
                                <p>Your most important portal sections</p>
                            </div>
                        </div>

                        <div class="quick-actions-list">
                            <a asp-controller="Internship"
                               asp-action="Index"
                               class="quick-action">

                                <span class="quick-action-icon blue-icon">
                                    <i class="bi bi-search"></i>
                                </span>

                                <span>
                                    <strong>Browse Internships</strong>
                                    <small>Discover verified opportunities</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Application"
                               asp-action="MyApplications"
                               class="quick-action">

                                <span class="quick-action-icon orange-icon">
                                    <i class="bi bi-file-earmark-check-fill"></i>
                                </span>

                                <span>
                                    <strong>My Applications</strong>
                                    <small>Track application status and timeline</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Interview"
                               asp-action="MyInterviews"
                               class="quick-action">

                                <span class="quick-action-icon purple-icon">
                                    <i class="bi bi-calendar2-check-fill"></i>
                                </span>

                                <span>
                                    <strong>My Interviews</strong>
                                    <small>Accept and manage interview invitations</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="SavedInternship"
                               asp-action="Index"
                               class="quick-action">

                                <span class="quick-action-icon pink-icon">
                                    <i class="bi bi-heart-fill"></i>
                                </span>

                                <span>
                                    <strong>Saved Internships</strong>
                                    <small>@Model.StudentSavedInternships saved opportunities</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Student"
                               asp-action="Profile"
                               class="quick-action">

                                <span class="quick-action-icon green-icon">
                                    <i class="bi bi-person-circle"></i>
                                </span>

                                <span>
                                    <strong>My Profile</strong>
                                    <small>Update your information and CV</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <section class="dashboard-grid">
                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Upcoming Interviews</h3>
                                <p>Your next interview appointments</p>
                            </div>

                            <a asp-controller="Interview"
                               asp-action="MyInterviews"
                               class="view-all-link">
                                View All
                            </a>
                        </div>

                        @if (Model.UpcomingInterviews.Any())
                        {
                            @foreach (var interview in Model.UpcomingInterviews)
                            {
                                <div class="interview-item">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="interview-date-box">
                                            <strong>
                                                @interview.ScheduledAt.ToString("dd")
                                            </strong>

                                            <small>
                                                @interview.ScheduledAt.ToString("MMM")
                                            </small>
                                        </div>

                                        <div class="item-information">
                                            <strong>
                                                @interview.InternshipApplication.Internship.Title
                                            </strong>

                                            <small>
                                                @interview.InternshipApplication.Internship.Company.Name
                                                · @interview.ScheduledAt.ToString("hh:mm tt")
                                            </small>
                                        </div>
                                    </div>

                                    <span class="item-status interviewscheduled">
                                        @interview.Status
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>📅</span>
                                <h4>No upcoming interviews</h4>
                                <p>New interview invitations will appear here.</p>
                            </div>
                        }
                    </div>

                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Available Opportunities</h3>
                                <p>Recently published internships</p>
                            </div>

                            <a asp-controller="Internship"
                               asp-action="Index"
                               class="view-all-link">
                                View All
                            </a>
                        </div>

                        @if (Model.RecentInternships.Any())
                        {
                            @foreach (var internship in Model.RecentInternships)
                            {
                                <div class="internship-item">
                                    <div class="item-information">
                                        <strong>@internship.Title</strong>

                                        <small>
                                            @internship.Company.Name
                                            · @internship.Location
                                        </small>
                                    </div>

                                    <a asp-controller="Internship"
                                       asp-action="Details"
                                       asp-route-id="@internship.Id"
                                       class="view-all-link">
                                        View
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>💼</span>
                                <h4>No opportunities yet</h4>
                                <p>Approved internships will appear here.</p>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (isCompany)
            {
                <section class="statistics-grid">
                    <div class="statistic-card">
                        <div class="statistic-icon blue-icon">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>

                        <h2>@Model.CompanyInternships</h2>
                        <p>My internships</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon green-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>

                        <h2>@Model.CompanyApprovedInternships</h2>
                        <p>Approved internships</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon orange-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <h2>@Model.CompanyApplicants</h2>
                        <p>Total applicants</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon purple-icon">
                            <i class="bi bi-calendar2-check-fill"></i>
                        </div>

                        <h2>@Model.CompanyUpcomingInterviews</h2>
                        <p>Upcoming interviews</p>
                    </div>
                </section>

                <section class="dashboard-grid">
                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>My Recent Internships</h3>
                                <p>Manage your published opportunities</p>
                            </div>

                            <a asp-controller="Internship"
                               asp-action="MyInternships"
                               class="view-all-link">
                                View All
                            </a>
                        </div>

                        @if (Model.RecentInternships.Any())
                        {
                            @foreach (var internship in Model.RecentInternships)
                            {
                                <div class="internship-item">
                                    <div class="item-information">
                                        <strong>@internship.Title</strong>

                                        <small>
                                            @internship.Location
                                            · @internship.CreatedAt.ToString("dd MMM yyyy")
                                        </small>
                                    </div>

                                    @if (internship.IsApproved)
                                    {
                                        <a asp-controller="Application"
                                           asp-action="Applicants"
                                           asp-route-internshipId="@internship.Id"
                                           class="view-all-link">
                                            Applicants
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="item-status pending">
                                            Pending Approval
                                        </span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>💼</span>
                                <h4>No internships yet</h4>
                                <p>Create your first internship opportunity.</p>
                            </div>
                        }
                    </div>

                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Company Actions</h3>
                                <p>Manage opportunities and candidates</p>
                            </div>
                        </div>

                        <div class="quick-actions-list">
                            <a asp-controller="Internship"
                               asp-action="Create"
                               class="quick-action">

                                <span class="quick-action-icon blue-icon">
                                    <i class="bi bi-plus-circle-fill"></i>
                                </span>

                                <span>
                                    <strong>Add Internship</strong>
                                    <small>Publish a new training opportunity</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Internship"
                               asp-action="MyInternships"
                               class="quick-action">

                                <span class="quick-action-icon purple-icon">
                                    <i class="bi bi-people-fill"></i>
                                </span>

                                <span>
                                    <strong>Review Applicants</strong>
                                    <small>Select an internship to view candidates</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Company"
                               asp-action="Profile"
                               class="quick-action">

                                <span class="quick-action-icon green-icon">
                                    <i class="bi bi-building-fill"></i>
                                </span>

                                <span>
                                    <strong>Company Profile</strong>
                                    <small>Update company information and logo</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <section class="dashboard-grid">
                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Recent Applicants</h3>
                                <p>Latest applications to your internships</p>
                            </div>
                        </div>

                        @if (Model.RecentApplications.Any())
                        {
                            @foreach (var application in Model.RecentApplications)
                            {
                                var statusClass =
                                    application.Status
                                        .ToString()
                                        .ToLowerInvariant();

                                <div class="application-item">
                                    <div class="item-information">
                                        <strong>
                                            @application.Student.FullName
                                        </strong>

                                        <small>
                                            @application.Internship.Title
                                            · @application.AppliedAt.ToString("dd MMM")
                                        </small>
                                    </div>

                                    <span class="item-status @statusClass">
                                        @application.Status
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>📄</span>
                                <h4>No applications yet</h4>
                                <p>New student applications will appear here.</p>
                            </div>
                        }
                    </div>

                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Upcoming Interviews</h3>
                                <p>Scheduled candidate interviews</p>
                            </div>
                        </div>

                        @if (Model.UpcomingInterviews.Any())
                        {
                            @foreach (var interview in Model.UpcomingInterviews)
                            {
                                <div class="interview-item">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="interview-date-box">
                                            <strong>
                                                @interview.ScheduledAt.ToString("dd")
                                            </strong>

                                            <small>
                                                @interview.ScheduledAt.ToString("MMM")
                                            </small>
                                        </div>

                                        <div class="item-information">
                                            <strong>
                                                @interview.InternshipApplication.Student.FullName
                                            </strong>

                                            <small>
                                                @interview.InternshipApplication.Internship.Title
                                                · @interview.ScheduledAt.ToString("hh:mm tt")
                                            </small>
                                        </div>
                                    </div>

                                    <span class="item-status interviewscheduled">
                                        @interview.Status
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>📅</span>
                                <h4>No upcoming interviews</h4>
                                <p>Scheduled interviews will appear here.</p>
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="statistics-grid">
                    <div class="statistic-card">
                        <div class="statistic-icon blue-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <h2>@Model.TotalStudents</h2>
                        <p>Registered students</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon purple-icon">
                            <i class="bi bi-building-fill"></i>
                        </div>

                        <h2>@Model.TotalCompanies</h2>
                        <p>Registered companies</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon green-icon">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>

                        <h2>@Model.ApprovedInternships</h2>
                        <p>Approved internships</p>
                    </div>

                    <div class="statistic-card">
                        <div class="statistic-icon orange-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>

                        <h2>@Model.TotalApplications</h2>
                        <p>Total applications</p>
                    </div>
                </section>

                <section class="dashboard-grid">
                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Recent Internships</h3>
                                <p>Latest opportunities across the portal</p>
                            </div>

                            <a asp-controller="Admin"
                               asp-action="AllInternships"
                               class="view-all-link">
                                View All
                            </a>
                        </div>

                        @if (Model.RecentInternships.Any())
                        {
                            @foreach (var internship in Model.RecentInternships)
                            {
                                <div class="internship-item">
                                    <div class="item-information">
                                        <strong>@internship.Title</strong>

                                        <small>
                                            @internship.Company.Name
                                            · @internship.Location
                                        </small>
                                    </div>

                                    <span class="item-status
                                        @(internship.IsApproved
                                            ? "approved"
                                            : "pending")">

                                        @(internship.IsApproved
                                            ? "Approved"
                                            : "Pending")
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <span>💼</span>
                                <h4>No internships yet</h4>
                            </div>
                        }
                    </div>

                    <div class="dashboard-card">
                        <div class="section-heading">
                            <div>
                                <h3>Admin Actions</h3>
                                <p>Manage and monitor the portal</p>
                            </div>
                        </div>

                        <div class="quick-actions-list">
                            <a asp-controller="Admin"
                               asp-action="PendingInternships"
                               class="quick-action">

                                <span class="quick-action-icon orange-icon">
                                    <i class="bi bi-hourglass-split"></i>
                                </span>

                                <span>
                                    <strong>Review Internships</strong>
                                    <small>Approve or reject new opportunities</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="Admin"
                               asp-action="AllInternships"
                               class="quick-action">

                                <span class="quick-action-icon green-icon">
                                    <i class="bi bi-briefcase-fill"></i>
                                </span>

                                <span>
                                    <strong>All Internships</strong>
                                    <small>View every published opportunity</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>

                            <a asp-controller="UserManagement"
                               asp-action="Index"
                               class="quick-action">

                                <span class="quick-action-icon purple-icon">
                                    <i class="bi bi-people-fill"></i>
                                </span>

                                <span>
                                    <strong>Manage Users</strong>
                                    <small>Manage students and companies</small>
                                </span>

                                <i class="bi bi-arrow-right quick-arrow"></i>
                            </a>
                        </div>
                    </div>
                </section>
            }
        }
    </div>
</div>