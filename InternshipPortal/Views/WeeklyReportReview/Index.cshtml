@model IEnumerable<InternshipPortal.Models.WeeklyReport>
@using InternshipPortal.Models.Enums

@{
    ViewData["Title"] = "Weekly Report Review";

    var reports = Model.ToList();
    var isCompany = User.IsInRole("Company");
    var isSupervisor =
        User.IsInRole("UniversitySupervisor");

    var awaitingReview = reports.Count(report =>
        isCompany
            ? report.Status ==
                WeeklyReportStatus.Submitted
            : report.Status ==
                WeeklyReportStatus.CompanyApproved);

    var approvedCount = reports.Count(report =>
        isCompany
            ? report.Status ==
                WeeklyReportStatus.CompanyApproved ||
              report.Status ==
                WeeklyReportStatus.SupervisorApproved
            : report.Status ==
                WeeklyReportStatus.SupervisorApproved);

    var returnedCount = reports.Count(report =>
        report.Status ==
            WeeklyReportStatus.CompanyRejected ||
        report.Status ==
            WeeklyReportStatus.SupervisorReturned);
}

<style>
    .review-page {
        min-height: 100vh;
        padding: 45px 0 70px;
        background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.14), transparent 35%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.13), transparent 35%), #f8fafc;
    }

    .review-header {
        position: relative;
        overflow: hidden;
        padding: 37px;
        margin-bottom: 25px;
        color: white;
        border-radius: 27px;
        background: linear-gradient(135deg, #172554, #6d28d9, #0284c7);
        box-shadow: 0 22px 48px rgba(109, 40, 217, 0.24);
        animation: headerAppear 0.7s ease;
    }

        .review-header::after {
            position: absolute;
            width: 280px;
            height: 280px;
            right: -80px;
            bottom: -180px;
            content: "";
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-icon {
        min-width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 18px;
        font-size: 30px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.17);
        animation: iconFloat 3s ease-in-out infinite;
    }

    .review-header h1 {
        margin: 0;
        font-weight: 900;
    }

    .review-header p {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.8);
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        font-size: 12px;
        font-weight: 900;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.16);
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
        margin-bottom: 27px;
    }

    .statistic-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 19px;
        background: white;
        box-shadow: 0 10px 27px rgba(15, 23, 42, 0.07);
        transition: 0.3s;
    }

        .statistic-card:hover {
            transform: translateY(-5px);
        }

    .statistic-icon {
        min-width: 51px;
        height: 51px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        border-radius: 16px;
    }

    .review-icon {
        color: #b45309;
        background: #fef3c7;
    }

    .approved-icon {
        color: #047857;
        background: #d1fae5;
    }

    .returned-icon {
        color: #b91c1c;
        background: #fee2e2;
    }

    .statistic-number {
        display: block;
        color: #0f172a;
        font-size: 25px;
        font-weight: 900;
    }

    .statistic-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .report-card {
        padding: 25px;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 23px;
        background: white;
        box-shadow: 0 11px 30px rgba(15, 23, 42, 0.07);
        transition: 0.35s;
        animation: cardAppear 0.7s ease both;
    }

        .report-card:hover {
            border-color: #ddd6fe;
            transform: translateY(-5px);
            box-shadow: 0 19px 39px rgba(109, 40, 217, 0.13);
        }

    .student-avatar {
        min-width: 61px;
        height: 61px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        font-weight: 900;
        border-radius: 19px;
        background: linear-gradient(135deg, #7c3aed, #0284c7);
    }

    .student-name {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 18px;
        font-weight: 900;
    }

    .internship-name {
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .report-period {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 11px;
    }

    .week-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        color: #5b21b6;
        font-size: 11px;
        font-weight: 900;
        border-radius: 20px;
        background: #ede9fe;
    }

    .report-content {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-top: 20px;
    }

    .content-box {
        padding: 17px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #f8fafc;
    }

        .content-box h4 {
            margin: 0 0 8px;
            color: #334155;
            font-size: 12px;
            font-weight: 900;
        }

        .content-box p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.7;
            white-space: pre-line;
        }

    .previous-feedback {
        padding: 14px;
        margin-top: 14px;
        color: #475569;
        font-size: 12px;
        line-height: 1.7;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
    }

    .review-form {
        padding-top: 19px;
        margin-top: 19px;
        border-top: 1px solid #f1f5f9;
    }

    .review-grid {
        display: grid;
        grid-template-columns: 1fr 180px;
        gap: 12px;
    }

    .review-input {
        min-height: 49px;
        border: 2px solid #e2e8f0;
        border-radius: 13px;
        background: #f8fafc;
    }

        .review-input:focus {
            border-color: #7c3aed;
            background: white;
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.1);
        }

    .review-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 12px;
    }

    .approve-button,
    .return-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 17px;
        font-size: 12px;
        font-weight: 900;
        border: none;
        border-radius: 12px;
        transition: 0.3s;
    }

    .approve-button {
        color: white;
        background: linear-gradient(135deg, #059669, #10b981);
    }

    .return-button {
        color: #b91c1c;
        background: #fee2e2;
    }

        .approve-button:hover,
        .return-button:hover {
            color: white;
            transform: translateY(-3px);
        }

        .return-button:hover {
            background: #ef4444;
        }

    .reviewed-result {
        padding: 14px;
        margin-top: 18px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 700;
    }

    .approved-result {
        color: #047857;
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
    }

    .returned-result {
        color: #b91c1c;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .rating-stars {
        margin-left: 8px;
        color: #f59e0b;
    }

    .empty-state {
        padding: 80px 25px;
        text-align: center;
        border: 2px dashed #cbd5e1;
        border-radius: 25px;
        background: white;
    }

        .empty-state span {
            display: block;
            font-size: 75px;
        }

        .empty-state h3 {
            margin-top: 18px;
            color: #0f172a;
            font-weight: 900;
        }

        .empty-state p {
            color: #64748b;
        }

    @@keyframes headerAppear {
        from {
            opacity: 0;
            transform: translateY(-25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@media (max-width: 768px) {
        .statistics-grid,
        .report-content,
        .review-grid {
            grid-template-columns: 1fr;
        }

        .review-actions {
            flex-direction: column;
        }

        .approve-button,
        .return-button {
            width: 100%;
        }
    }
</style>

<div class="review-page">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="review-header">
            <div class="header-content d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center">
                    <div class="header-icon">
                        <i class="bi bi-journal-check"></i>
                    </div>

                    <div>
                        <h1>Weekly Report Review</h1>

                        <p>
                            @(isCompany
                                                        ? "Review student progress before sending reports to the university."
                                                        : "Provide final academic verification for company-approved reports.")
                        </p>
                    </div>
                </div>

                <span class="role-badge">
                    @if (isCompany)
                    {
                        <i class="bi bi-building-check"></i>
                        <text>Company Review</text>
                    }
                    else
                    {
                        <i class="bi bi-mortarboard-fill"></i>
                        <text>University Review</text>
                    }
                </span>
            </div>
        </div>

        <div class="statistics-grid">
            <div class="statistic-card">
                <div class="statistic-icon review-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @awaitingReview
                    </span>

                    <span class="statistic-label">
                        Awaiting Your Review
                    </span>
                </div>
            </div>

            <div class="statistic-card">
                <div class="statistic-icon approved-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @approvedCount
                    </span>

                    <span class="statistic-label">
                        Approved Reports
                    </span>
                </div>
            </div>

            <div class="statistic-card">
                <div class="statistic-icon returned-icon">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @returnedCount
                    </span>

                    <span class="statistic-label">
                        Returned Reports
                    </span>
                </div>
            </div>
        </div>

        @if (reports.Any())
        {
            var animationDelay = 0;

            foreach (var report in reports)
            {
                var enrollment =
                report.TrainingEnrollment;

                var application =
                enrollment.InternshipApplication;

                var student = application.Student;
                var internship = application.Internship;

                var canCompanyReview =
                isCompany &&
                report.Status ==
                WeeklyReportStatus.Submitted;

                var canSupervisorReview =
                isSupervisor &&
                report.Status ==
                WeeklyReportStatus.CompanyApproved;

                var isFullyApproved =
                report.Status ==
                WeeklyReportStatus.SupervisorApproved;

                var isReturned =
                report.Status ==
                WeeklyReportStatus.CompanyRejected ||
                report.Status ==
                WeeklyReportStatus.SupervisorReturned;

                <div class="report-card"
                     style="animation-delay: @(animationDelay)ms">

                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="student-avatar">
                                @(string.IsNullOrWhiteSpace(student.FullName)
                                                        ? "S"
                                                        : student.FullName
                                                        .Substring(0, 1)
                                                        .ToUpper())
                    </div>

                            <div>
                                <h3 class="student-name">
                                    @student.FullName
                                </h3>

                                <div class="internship-name">
                                    <i class="bi bi-briefcase-fill me-1"></i>
                                    @internship.Title
                                    —
                                    @internship.Company.Name
                                </div>

                                <div class="report-period">
                                    <i class="bi bi-calendar-range me-1"></i>

                                    @report.WeekStartDate.ToString("dd MMM")
                                    -
                                    @report.WeekEndDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <span class="week-badge">
                            <i class="bi bi-calendar-week"></i>
                            Week @report.WeekNumber
                        </span>
                    </div>

                    <div class="report-content">
                        <div class="content-box">
                            <h4>
                                <i class="bi bi-list-check me-1"></i>
                                Tasks Completed
                            </h4>

                            <p>@report.TasksCompleted</p>
                        </div>

                        <div class="content-box">
                            <h4>
                                <i class="bi bi-stars me-1"></i>
                                Skills Learned
                            </h4>

                            <p>@report.SkillsLearned</p>
                        </div>

                @if (!string.IsNullOrWhiteSpace(
                                report.Challenges))
                        {
                            <div class="content-box">
                                <h4>
                                    <i class="bi bi-lightning-charge me-1"></i>
                                    Challenges
                                </h4>

                                <p>@report.Challenges</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                                        report.NextWeekPlan))
                        {
                            <div class="content-box">
                                <h4>
                                    <i class="bi bi-calendar2-check me-1"></i>
                                    Next Week Plan
                                </h4>

                                <p>@report.NextWeekPlan</p>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                                report.CompanyFeedback))
                    {
                        <div class="previous-feedback">
                            <strong>
                                <i class="bi bi-building-check me-1"></i>
                                Company Feedback:
                            </strong>

                            @report.CompanyFeedback

                            @if (report.CompanyRating.HasValue)
                            {
                                <span class="rating-stars">
                                    @for (var star = 1;
                                                        star <= report.CompanyRating;
                                                        star++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(
                                report.SupervisorFeedback))
                    {
                        <div class="previous-feedback">
                            <strong>
                                <i class="bi bi-mortarboard-fill me-1"></i>
                                Supervisor Feedback:
                            </strong>

                            @report.SupervisorFeedback
                        </div>
                    }

                    @if (canCompanyReview ||
                                canSupervisorReview)
                    {
                        <div class="review-form">
                            <form method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@report.Id" />

                                <div class="review-grid">
                                    <input type="text"
                                           name="feedback"
                                           class="form-control review-input"
                                           placeholder="Write feedback or return reason..." />

                                    <select name="rating"
                                            class="form-select review-input">

                                        <option value="0">
                                            Select Rating
                                        </option>

                                        <option value="5">
                                            5 - Excellent
                                        </option>

                                        <option value="4">
                                            4 - Very Good
                                        </option>

                                        <option value="3">
                                            3 - Good
                                        </option>

                                        <option value="2">
                                            2 - Fair
                                        </option>

                                        <option value="1">
                                            1 - Needs Improvement
                                        </option>
                                    </select>
                                </div>

                                <div class="review-actions">
                                    @if (canCompanyReview)
                                    {
                                        <button type="submit"
                                                asp-action="CompanyReject"
                                                class="return-button"
                                                onclick="return confirm('Return this report to the student?');">

                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            Return Report
                                        </button>

                                        <button type="submit"
                                                asp-action="CompanyApprove"
                                                class="approve-button"
                                                onclick="return confirm('Approve this weekly report?');">

                                            <i class="bi bi-check-circle-fill"></i>
                                            Approve & Send to University
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                asp-action="SupervisorReturn"
                                                class="return-button"
                                                onclick="return confirm('Return this report for revision?');">

                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            Return for Revision
                                        </button>

                                        <button type="submit"
                                                asp-action="SupervisorApprove"
                                                class="approve-button"
                                                onclick="return confirm('Give final approval to this report?');">

                                            <i class="bi bi-patch-check-fill"></i>
                                            Final Approval
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }
                    else if (isFullyApproved)
                    {
                        <div class="reviewed-result approved-result">
                            <i class="bi bi-patch-check-fill me-1"></i>
                            This weekly report is fully verified
                            by the company and university.
                        </div>
                    }
                    else if (isReturned)
                    {
                        <div class="reviewed-result returned-result">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            This report was returned to the
                            student for revision.
                        </div>
                    }
                </div>

                animationDelay += 80;
            }
        }
        else
        {
            <div class="empty-state">
                <span>📋</span>

                <h3>No Reports to Review</h3>

                <p>
                    Weekly training reports requiring your
                    review will appear here.
                </p>
            </div>
        }
    </div>
</div>