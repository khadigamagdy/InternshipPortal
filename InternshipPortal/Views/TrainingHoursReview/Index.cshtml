@model IEnumerable<InternshipPortal.Models.TrainingHourEntry>
@using InternshipPortal.Models.Enums

@{
    ViewData["Title"] = "Training Hours Review";

    var entries = Model.ToList();

    var pendingCount = entries.Count(entry =>
        entry.Status == TrainingHourStatus.Pending);

    var approvedCount = entries.Count(entry =>
        entry.Status == TrainingHourStatus.Approved);

    var rejectedCount = entries.Count(entry =>
        entry.Status == TrainingHourStatus.Rejected);

    var approvedHours = entries
        .Where(entry =>
            entry.Status == TrainingHourStatus.Approved)
        .Sum(entry => entry.Hours);
}

<style>
    .review-page {
        min-height: 100vh;
        padding: 45px 0 70px;
        background: radial-gradient(circle at top left, rgba(14, 165, 233, 0.14), transparent 35%), radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.13), transparent 35%), #f8fafc;
    }

    .review-header {
        position: relative;
        overflow: hidden;
        padding: 37px;
        margin-bottom: 25px;
        color: white;
        border-radius: 27px;
        background: linear-gradient(135deg, #082f49, #0369a1, #059669);
        box-shadow: 0 22px 48px rgba(3, 105, 161, 0.24);
        animation: headerAppear 0.7s ease;
    }

        .review-header::after {
            position: absolute;
            width: 280px;
            height: 280px;
            right: -80px;
            bottom: -180px;
            content: "";
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-icon {
        min-width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 18px;
        font-size: 30px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.17);
        animation: iconFloat 3s ease-in-out infinite;
    }

    .review-header h1 {
        margin: 0;
        font-weight: 900;
    }

    .review-header p {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.8);
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        font-size: 12px;
        font-weight: 900;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.16);
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 17px;
        margin-bottom: 27px;
    }

    .statistic-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 19px;
        background: white;
        box-shadow: 0 10px 27px rgba(15, 23, 42, 0.07);
        transition: 0.3s;
    }

        .statistic-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 17px 35px rgba(3, 105, 161, 0.14);
        }

    .statistic-icon {
        min-width: 51px;
        height: 51px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        border-radius: 16px;
    }

    .pending-icon {
        color: #b45309;
        background: #fef3c7;
    }

    .approved-icon {
        color: #047857;
        background: #d1fae5;
    }

    .rejected-icon {
        color: #b91c1c;
        background: #fee2e2;
    }

    .hours-icon {
        color: #0369a1;
        background: #e0f2fe;
    }

    .statistic-number {
        display: block;
        color: #0f172a;
        font-size: 25px;
        font-weight: 900;
    }

    .statistic-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .entry-card {
        padding: 25px;
        margin-bottom: 19px;
        border: 1px solid #e2e8f0;
        border-radius: 23px;
        background: white;
        box-shadow: 0 11px 30px rgba(15, 23, 42, 0.07);
        transition: 0.35s;
        animation: cardAppear 0.7s ease both;
    }

        .entry-card:hover {
            border-color: #bae6fd;
            transform: translateY(-5px);
            box-shadow: 0 19px 39px rgba(3, 105, 161, 0.14);
        }

    .student-avatar {
        min-width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        font-weight: 900;
        border-radius: 19px;
        background: linear-gradient(135deg, #0284c7, #10b981);
    }

    .student-name {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 18px;
        font-weight: 900;
    }

    .internship-name {
        color: #475569;
        font-size: 13px;
        font-weight: 700;
    }

    .entry-date {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 12px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        font-size: 11px;
        font-weight: 900;
        border-radius: 20px;
    }

    .status-pending {
        color: #b45309;
        background: #fef3c7;
    }

    .status-approved {
        color: #047857;
        background: #d1fae5;
    }

    .status-rejected {
        color: #b91c1c;
        background: #fee2e2;
    }

    .entry-information {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 14px;
        margin-top: 20px;
    }

    .hours-box {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        min-height: 125px;
        color: white;
        border-radius: 18px;
        background: linear-gradient(135deg, #0369a1, #0891b2);
    }

        .hours-box strong {
            font-size: 31px;
            font-weight: 900;
        }

        .hours-box span {
            font-size: 11px;
            font-weight: 700;
            opacity: 0.82;
        }

    .task-box {
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        background: #f8fafc;
    }

        .task-box h4 {
            margin: 0 0 9px;
            color: #0f172a;
            font-size: 15px;
            font-weight: 900;
        }

        .task-box p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.7;
        }

    .skills-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        margin-top: 12px;
        color: #0369a1;
        font-size: 11px;
        font-weight: 800;
        border-radius: 20px;
        background: #e0f2fe;
    }

    .review-form {
        padding-top: 19px;
        margin-top: 19px;
        border-top: 1px solid #f1f5f9;
    }

    .comment-input {
        min-height: 48px;
        border: 2px solid #e2e8f0;
        border-radius: 13px;
        background: #f8fafc;
        transition: 0.3s;
    }

        .comment-input:focus {
            border-color: #0284c7;
            background: white;
            box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
        }

    .review-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 11px;
    }

    .approve-button,
    .reject-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 900;
        border: none;
        border-radius: 12px;
        transition: 0.3s;
    }

    .approve-button {
        color: white;
        background: linear-gradient(135deg, #059669, #10b981);
    }

    .reject-button {
        color: #b91c1c;
        background: #fee2e2;
    }

        .approve-button:hover,
        .reject-button:hover {
            color: white;
            transform: translateY(-3px);
        }

        .reject-button:hover {
            background: #ef4444;
        }

    .review-result {
        padding: 14px;
        margin-top: 18px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 700;
    }

    .approved-result {
        color: #047857;
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
    }

    .rejected-result {
        color: #b91c1c;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .empty-state {
        padding: 80px 25px;
        text-align: center;
        border: 2px dashed #cbd5e1;
        border-radius: 25px;
        background: white;
    }

        .empty-state span {
            display: block;
            font-size: 75px;
        }

        .empty-state h3 {
            margin-top: 18px;
            color: #0f172a;
            font-weight: 900;
        }

        .empty-state p {
            color: #64748b;
        }

    @@keyframes headerAppear {
        from {
            opacity: 0;
            transform: translateY(-25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@media (max-width: 992px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .statistics-grid,
        .entry-information {
            grid-template-columns: 1fr;
        }

        .review-actions {
            flex-direction: column;
        }

        .approve-button,
        .reject-button {
            width: 100%;
        }
    }
</style>

<div class="review-page">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="review-header">
            <div class="header-content d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center">
                    <div class="header-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>
                        <h1>Training Hours Review</h1>

                        <p>
                            Verify student activities and approve
                            completed internship hours.
                        </p>
                    </div>
                </div>

                <span class="header-badge">
                    <i class="bi bi-building-check"></i>
                    Company Verification
                </span>
            </div>
        </div>

        <div class="statistics-grid">
            <div class="statistic-card">
                <div class="statistic-icon pending-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @pendingCount
                    </span>

                    <span class="statistic-label">
                        Pending Entries
                    </span>
                </div>
            </div>

            <div class="statistic-card">
                <div class="statistic-icon approved-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @approvedCount
                    </span>

                    <span class="statistic-label">
                        Approved Entries
                    </span>
                </div>
            </div>

            <div class="statistic-card">
                <div class="statistic-icon rejected-icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @rejectedCount
                    </span>

                    <span class="statistic-label">
                        Rejected Entries
                    </span>
                </div>
            </div>

            <div class="statistic-card">
                <div class="statistic-icon hours-icon">
                    <i class="bi bi-stopwatch-fill"></i>
                </div>

                <div>
                    <span class="statistic-number">
                        @approvedHours.ToString("0.0")
                    </span>

                    <span class="statistic-label">
                        Verified Hours
                    </span>
                </div>
            </div>
        </div>

        @if (entries.Any())
        {
            var animationDelay = 0;

            foreach (var entry in entries)
            {
                var application =
                entry.TrainingEnrollment
                .InternshipApplication;

                var student = application.Student;
                var internship = application.Internship;

                var statusClass =
                entry.Status switch
                {
                    TrainingHourStatus.Approved =>
                    "status-approved",

                    TrainingHourStatus.Rejected =>
                    "status-rejected",

                    _ => "status-pending"
                };

                var statusIcon =
                entry.Status switch
                {
                    TrainingHourStatus.Approved =>
                    "bi-check-circle-fill",

                    TrainingHourStatus.Rejected =>
                    "bi-x-circle-fill",

                    _ => "bi-hourglass-split"
                };

                <div class="entry-card"
                     style="animation-delay: @(animationDelay)ms">

                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="student-avatar">
                                @(string.IsNullOrWhiteSpace(student.FullName)
                                                        ? "S"
                                                        : student.FullName
                                                        .Substring(0, 1)
                                                        .ToUpper())
                    </div>

                            <div>
                                <h3 class="student-name">
                                    @student.FullName
                                </h3>

                                <div class="internship-name">
                                    <i class="bi bi-briefcase-fill me-1"></i>
                                    @internship.Title
                                </div>

                                <div class="entry-date">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    Training date:
                                    @entry.TrainingDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <span class="status-badge @statusClass">
                            <i class="bi @statusIcon"></i>
                            @entry.Status
                        </span>
                    </div>

                    <div class="entry-information">
                        <div class="hours-box">
                            <strong>
                                @entry.Hours.ToString("0.0")
                            </strong>

                            <span>Submitted Hours</span>
                        </div>

                        <div class="task-box">
                            <h4>@entry.TaskTitle</h4>
                            <p>@entry.TaskDescription</p>

                    @if (!string.IsNullOrWhiteSpace(
                                        entry.LearnedSkills))
                            {
                                <span class="skills-box">
                                    <i class="bi bi-stars"></i>
                                    @entry.LearnedSkills
                                </span>
                            }
                        </div>
                    </div>

                    @if (entry.Status ==
                                TrainingHourStatus.Pending)
                    {
                        <div class="review-form">
                            <form method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@entry.Id" />

                                <input type="text"
                                       name="companyComment"
                                       class="form-control comment-input"
                                       placeholder="Write a review comment or rejection reason..." />

                                <div class="review-actions">
                                    <button type="submit"
                                            asp-action="Reject"
                                            class="reject-button"
                                            onclick="return confirm('Reject these training hours?');">

                                        <i class="bi bi-x-circle-fill"></i>
                                        Reject Hours
                                    </button>

                                    <button type="submit"
                                            asp-action="Approve"
                                            class="approve-button"
                                            onclick="return confirm('Approve these training hours?');">

                                        <i class="bi bi-check-circle-fill"></i>
                                        Approve Hours
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else if (entry.Status ==
                    TrainingHourStatus.Approved)
                    {
                        <div class="review-result approved-result">
                            <i class="bi bi-patch-check-fill me-1"></i>

                            @entry.CompanyComment

                            @if (entry.ReviewedAt.HasValue)
                            {
                                <span>
                                    — Reviewed on
                                    @entry.ReviewedAt.Value.ToString(
                                    "dd MMM yyyy")
                </span>
                                }
                        </div>
                    }
                    else
                    {
                        <div class="review-result rejected-result">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>

                            @entry.CompanyComment
                        </div>
                    }
                </div>

                animationDelay += 80;
            }
        }
        else
        {
            <div class="empty-state">
                <span>⏱️</span>
                <h3>No Training Hours Yet</h3>

                <p>
                    Student training-hour submissions will
                    appear here for verification.
                </p>
            </div>
        }
    </div>
</div>