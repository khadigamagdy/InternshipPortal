@model InternshipPortal.Models.ViewModels.InternshipAnalyticsViewModel

@{
    ViewData["Title"] = "Internship Analytics";

    var maximumMonthlyApplications =
        Model.MonthlyTrends.Any()
            ? Model.MonthlyTrends.Max(item =>
                item.Applications)
            : 0;

    if (maximumMonthlyApplications == 0)
    {
        maximumMonthlyApplications = 1;
    }
}

<style>
    .analytics-page {
        min-height: 100vh;
        padding: 42px 0 70px;
        background: radial-gradient(circle at top left, rgba(79, 70, 229, 0.14), transparent 34%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.12), transparent 35%), #f8fafc;
    }

    .analytics-hero {
        position: relative;
        overflow: hidden;
        padding: 40px;
        margin-bottom: 23px;
        color: white;
        border-radius: 29px;
        background: linear-gradient(135deg, #172554, #4338ca 55%, #0891b2);
        box-shadow: 0 23px 52px rgba(30, 41, 59, 0.22);
        animation: analyticsEntrance 0.7s ease;
    }

        .analytics-hero::before,
        .analytics-hero::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50%;
        }

        .analytics-hero::before {
            width: 320px;
            height: 320px;
            top: -170px;
            right: -60px;
        }

        .analytics-hero::after {
            width: 200px;
            height: 200px;
            right: 80px;
            bottom: -145px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .hero-title {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .hero-icon {
        min-width: 67px;
        height: 67px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.16);
    }

    .analytics-hero h1 {
        margin: 0;
        font-size: 33px;
        font-weight: 900;
    }

    .analytics-hero p {
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.78);
    }

    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        color: #d1fae5;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid rgba(167, 243, 208, 0.28);
        border-radius: 24px;
        background: rgba(16, 185, 129, 0.17);
    }

    .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #34d399;
        animation: livePulse 1.6s infinite;
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 17px;
        margin-bottom: 23px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        padding: 21px;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 36px rgba(79, 70, 229, 0.12);
        }

    .stat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .stat-icon {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        border-radius: 14px;
    }

    .internship-icon {
        color: #4338ca;
        background: #e0e7ff;
    }

    .application-icon {
        color: #0369a1;
        background: #e0f2fe;
    }

    .completion-icon {
        color: #047857;
        background: #d1fae5;
    }

    .rating-icon {
        color: #c2410c;
        background: #ffedd5;
    }

    .stat-badge {
        padding: 5px 9px;
        color: #64748b;
        font-size: 9px;
        font-weight: 800;
        border-radius: 17px;
        background: #f1f5f9;
    }

    .stat-number {
        display: block;
        margin-top: 15px;
        color: #172554;
        font-size: 29px;
        font-weight: 900;
    }

    .stat-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
    }

    .stat-progress {
        height: 5px;
        overflow: hidden;
        margin-top: 15px;
        border-radius: 10px;
        background: #eef2f7;
    }

        .stat-progress span {
            display: block;
            height: 100%;
            min-width: 6px;
            border-radius: 10px;
            background: linear-gradient(90deg, #6366f1, #0ea5e9);
            animation: progressGrow 1.2s ease;
        }

    .analytics-layout {
        display: grid;
        grid-template-columns: 1.45fr 0.75fr;
        gap: 21px;
        margin-bottom: 23px;
    }

    .analytics-card {
        padding: 27px;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: white;
        box-shadow: 0 11px 31px rgba(15, 23, 42, 0.055);
        animation: analyticsEntrance 0.7s ease both;
    }

    .card-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 24px;
    }

        .card-heading h2 {
            margin: 0;
            color: #172554;
            font-size: 19px;
            font-weight: 900;
        }

        .card-heading p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

    .chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        color: #64748b;
        font-size: 9px;
        font-weight: 700;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .applications-dot {
        background: #6366f1;
    }

    .accepted-dot {
        background: #0ea5e9;
    }

    .completed-dot {
        background: #10b981;
    }

    .trend-chart {
        height: 260px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 14px;
        padding: 15px 10px 0;
        border-bottom: 1px solid #e2e8f0;
        background: repeating-linear-gradient( to bottom, transparent, transparent 49px, #f1f5f9 50px);
    }

    .month-column {
        height: 100%;
        flex: 1;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 4px;
    }

    .chart-bar {
        position: relative;
        min-width: 12px;
        max-width: 22px;
        height: 0;
        border-radius: 8px 8px 0 0;
        animation: chartGrow 1.2s ease forwards;
        transition: 0.3s;
    }

        .chart-bar:hover {
            filter: brightness(0.9);
            transform: scaleX(1.08);
        }

    .applications-bar {
        background: linear-gradient(to top, #4338ca, #818cf8);
    }

    .accepted-bar {
        background: linear-gradient(to top, #0284c7, #38bdf8);
    }

    .completed-bar {
        background: linear-gradient(to top, #059669, #34d399);
    }

    .chart-value {
        position: absolute;
        top: -21px;
        left: 50%;
        color: #475569;
        font-size: 8px;
        font-weight: 900;
        transform: translateX(-50%);
    }

    .month-labels {
        display: flex;
        justify-content: space-around;
        gap: 14px;
        padding: 9px 10px 0;
    }

    .month-label {
        flex: 1;
        color: #64748b;
        font-size: 9px;
        font-weight: 700;
        text-align: center;
    }

    .outcome-list {
        display: grid;
        gap: 17px;
    }

    .outcome-item {
        padding: 14px;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        background: #fbfdff;
    }

    .outcome-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 9px;
    }

    .outcome-name {
        color: #475569;
        font-size: 11px;
        font-weight: 800;
    }

    .outcome-value {
        color: #172554;
        font-size: 14px;
        font-weight: 900;
    }

    .outcome-track {
        height: 7px;
        overflow: hidden;
        border-radius: 10px;
        background: #eef2f7;
    }

        .outcome-track span {
            display: block;
            height: 100%;
            min-width: 5px;
            border-radius: 10px;
            animation: progressGrow 1.2s ease;
        }

    .acceptance-progress {
        background: linear-gradient(90deg, #6366f1, #818cf8);
    }

    .completion-progress {
        background: linear-gradient(90deg, #059669, #34d399);
    }

    .rejection-progress {
        background: linear-gradient(90deg, #dc2626, #fb7185);
    }

    .best-card {
        margin-top: 17px;
        padding: 17px;
        color: white;
        border-radius: 16px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        box-shadow: 0 10px 23px rgba(245, 158, 11, 0.22);
    }

        .best-card span,
        .best-card strong,
        .best-card small {
            display: block;
        }

        .best-card span {
            margin-bottom: 8px;
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .best-card strong {
            font-size: 15px;
        }

        .best-card small {
            margin-top: 5px;
            color: rgba(255, 255, 255, 0.8);
        }

    .performance-card {
        padding: 27px;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: white;
        box-shadow: 0 11px 31px rgba(15, 23, 42, 0.055);
    }

    .performance-table-wrapper {
        overflow-x: auto;
    }

    .performance-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
    }

        .performance-table th {
            padding: 13px 12px;
            color: #64748b;
            font-size: 10px;
            font-weight: 900;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
            text-transform: uppercase;
        }

        .performance-table td {
            padding: 15px 12px;
            color: #475569;
            font-size: 11px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .performance-table tbody tr {
            transition: 0.25s;
        }

            .performance-table tbody tr:hover {
                background: #f8faff;
            }

    .internship-name {
        display: block;
        color: #172554;
        font-size: 12px;
        font-weight: 900;
    }

    .company-name {
        display: block;
        margin-top: 4px;
        color: #94a3b8;
        font-size: 9px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        font-size: 9px;
        font-weight: 900;
        border-radius: 17px;
    }

    .active-status {
        color: #047857;
        background: #d1fae5;
    }

    .inactive-status {
        color: #b91c1c;
        background: #fee2e2;
    }

    .quality-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .quality-circle {
        --score: 0;
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4338ca;
        font-size: 10px;
        font-weight: 900;
        border-radius: 50%;
        background: radial-gradient(closest-side, white 72%, transparent 75%), conic-gradient( #6366f1 calc(var(--score) * 1%), #e2e8f0 0);
    }

    .details-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 8px 10px;
        color: #4338ca;
        font-size: 9px;
        font-weight: 900;
        border-radius: 9px;
        background: #eef2ff;
        text-decoration: none;
        transition: 0.3s;
    }

        .details-link:hover {
            color: white;
            background: #4f46e5;
            transform: translateY(-2px);
        }

    .empty-analytics {
        padding: 60px 20px;
        text-align: center;
        border: 2px dashed #cbd5e1;
        border-radius: 20px;
        background: #f8fafc;
    }

        .empty-analytics span {
            font-size: 65px;
        }

        .empty-analytics h3 {
            margin: 15px 0 5px;
            color: #172554;
            font-weight: 900;
        }

        .empty-analytics p {
            color: #64748b;
        }

    @@keyframes analyticsEntrance {
        from {
            opacity: 0;
            transform: translateY(23px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes progressGrow {
        from {
            width: 0;
        }
    }

    @@keyframes chartGrow {
        from {
            height: 0;
        }
    }

    @@keyframes livePulse {
        0%, 100% {
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
        }

        50% {
            opacity: 0.5;
            box-shadow: 0 0 0 6px rgba(52, 211, 153, 0);
        }
    }

    @@media (max-width: 1100px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .analytics-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .hero-content,
        .hero-title {
            align-items: flex-start;
            flex-direction: column;
        }

        .analytics-hero {
            padding: 29px 22px;
        }

            .analytics-hero h1 {
                font-size: 27px;
            }

        .trend-chart {
            gap: 6px;
        }

        .month-column {
            gap: 2px;
        }

        .chart-bar {
            min-width: 7px;
        }
    }

    @@media (max-width: 576px) {
        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .analytics-card,
        .performance-card {
            padding: 22px 18px;
        }
    }
</style>

<div class="analytics-page">
    <div class="container">
        <section class="analytics-hero">
            <div class="hero-content">
                <div class="hero-title">
                    <div class="hero-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <div>
                        <h1>Internship Quality Analytics</h1>

                        <p>
                            @if (Model.IsAdminView)
                            {
                                <span>
                                    Platform-wide internship outcomes
                                    and company performance.
                                </span>
                            }
                            else
                            {
                                <span>
                                    Performance insights for
                                    @Model.DashboardOwnerName.
                                </span>
                            }
                        </p>
                    </div>
                </div>

                <span class="live-badge">
                    <span class="live-dot"></span>
                    Live Outcomes Data
                </span>
            </div>
        </section>

        <section class="statistics-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon internship-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>

                    <span class="stat-badge">
                        @Model.ActiveInternships active
                    </span>
                </div>

                <span class="stat-number">
                    @Model.TotalInternships
                </span>

                <span class="stat-label">
                    Total Internships
                </span>

                <div class="stat-progress">
                    <span style="width:
                        @(Model.TotalInternships == 0
                                                      ? 0
                                                      : Model.ActiveInternships * 100 /
                                                        Model.TotalInternships)%">
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon application-icon">
                        <i class="bi bi-file-earmark-person-fill"></i>
                    </div>

                    <span class="stat-badge">
                        @Model.PendingApplications pending
                    </span>
                </div>

                <span class="stat-number">
                    @Model.TotalApplications
                </span>

                <span class="stat-label">
                    Total Applications
                </span>

                <div class="stat-progress">
                    <span style="width: @Model.AcceptanceRate%">
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon completion-icon">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>

                    <span class="stat-badge">
                        @Model.CompletedTrainings completed
                    </span>
                </div>

                <span class="stat-number">
                    @Model.CompletionRate.ToString("0.0")%
                </span>

                <span class="stat-label">
                    Training Completion Rate
                </span>

                <div class="stat-progress">
                    <span style="width: @Model.CompletionRate%">
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon rating-icon">
                        <i class="bi bi-star-fill"></i>
                    </div>

                    <span class="stat-badge">
                        out of 5
                    </span>
                </div>

                <span class="stat-number">
                    @Model.AverageRating.ToString("0.0")
                </span>

                <span class="stat-label">
                    Average Student Rating
                </span>

                <div class="stat-progress">
                    <span style="width:
                        @(Model.AverageRating / 5 * 100)%">
                    </span>
                </div>
            </div>
        </section>

        <section class="analytics-layout">
            <div class="analytics-card">
                <div class="card-heading">
                    <div>
                        <h2>Application Activity</h2>
                        <p>Activity during the last six months</p>
                    </div>

                    <div class="chart-legend">
                        <span class="legend-item">
                            <span class="legend-dot applications-dot"></span>
                            Applications
                        </span>

                        <span class="legend-item">
                            <span class="legend-dot accepted-dot"></span>
                            Accepted
                        </span>

                        <span class="legend-item">
                            <span class="legend-dot completed-dot"></span>
                            Completed
                        </span>
                    </div>
                </div>

                <div class="trend-chart">
                    @foreach (var month in Model.MonthlyTrends)
                    {
                        var applicationsHeight =
                        month.Applications * 210 /
                        maximumMonthlyApplications;

                        var acceptedHeight =
                        month.Accepted * 210 /
                        maximumMonthlyApplications;

                        var completedHeight =
                        month.Completed * 210 /
                        maximumMonthlyApplications;

                        <div class="month-column">
                            <div class="chart-bar applications-bar"
                                 style="height: @(applicationsHeight)px">
                                @if (month.Applications > 0)
                                {
                                    <span class="chart-value">
                                        @month.Applications
                                    </span>
                                }
                            </div>

                            <div class="chart-bar accepted-bar"
                                 style="height: @(acceptedHeight)px">
                                @if (month.Accepted > 0)
                                {
                                    <span class="chart-value">
                                        @month.Accepted
                                    </span>
                                }
                            </div>

                            <div class="chart-bar completed-bar"
                                 style="height: @(completedHeight)px">
                                @if (month.Completed > 0)
                                {
                                    <span class="chart-value">
                                        @month.Completed
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="month-labels">
                    @foreach (var month in Model.MonthlyTrends)
                    {
                        <span class="month-label">
                            @month.MonthName
                        </span>
                    }
                </div>
            </div>

            <aside class="analytics-card">
                <div class="card-heading">
                    <div>
                        <h2>Outcome Rates</h2>
                        <p>Application and training conversion</p>
                    </div>
                </div>

                <div class="outcome-list">
                    <div class="outcome-item">
                        <div class="outcome-top">
                            <span class="outcome-name">
                                Acceptance Rate
                            </span>

                            <span class="outcome-value">
                                @Model.AcceptanceRate.ToString("0.0")%
                            </span>
                        </div>

                        <div class="outcome-track">
                            <span class="acceptance-progress"
                                  style="width: @Model.AcceptanceRate%">
                            </span>
                        </div>
                    </div>

                    <div class="outcome-item">
                        <div class="outcome-top">
                            <span class="outcome-name">
                                Completion Rate
                            </span>

                            <span class="outcome-value">
                                @Model.CompletionRate.ToString("0.0")%
                            </span>
                        </div>

                        <div class="outcome-track">
                            <span class="completion-progress"
                                  style="width: @Model.CompletionRate%">
                            </span>
                        </div>
                    </div>

                    <div class="outcome-item">
                        <div class="outcome-top">
                            <span class="outcome-name">
                                Rejection Rate
                            </span>

                            <span class="outcome-value">
                                @Model.RejectionRate.ToString("0.0")%
                            </span>
                        </div>

                        <div class="outcome-track">
                            <span class="rejection-progress"
                                  style="width: @Model.RejectionRate%">
                            </span>
                        </div>
                    </div>

                    <div class="outcome-item">
                        <div class="outcome-top">
                            <span class="outcome-name">
                                Average Review Time
                            </span>

                            <span class="outcome-value">
                                @Model.AverageReviewHours.ToString("0.0") h
                            </span>
                        </div>
                    </div>
                </div>

                <div class="best-card">
                    <span>
                        <i class="bi bi-trophy-fill me-1"></i>
                        Best Performing Internship
                    </span>

                    <strong>@Model.BestInternshipTitle</strong>

                    <small>
                        Quality Score:
                        @Model.BestInternshipScore.ToString("0")
                        out of 100
                    </small>
                </div>
            </aside>
        </section>

        <section class="performance-card">
            <div class="card-heading">
                <div>
                    <h2>Internship Performance</h2>

                    <p>
                        Ranking based on demand, completion,
                        ratings and response time
                    </p>
                </div>

                <i class="bi bi-bar-chart-fill text-primary fs-4"></i>
            </div>

            @if (Model.InternshipPerformance.Any())
            {
                <div class="performance-table-wrapper">
                    <table class="performance-table">
                        <thead>
                            <tr>
                                <th>Internship</th>
                                <th>Status</th>
                                <th>Applications</th>
                                <th>Accepted</th>
                                <th>Completed</th>
                                <th>Acceptance</th>
                                <th>Completion</th>
                                <th>Rating</th>
                                <th>Review Time</th>
                                <th>Quality</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in
                                                    Model.InternshipPerformance)
                            {
                                <tr>
                                    <td>
                                        <span class="internship-name">
                                            @item.InternshipTitle
                                        </span>

                                        @if (Model.IsAdminView)
                                        {
                                            <span class="company-name">
                                                @item.CompanyName
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-badge active-status">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive-status">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>@item.TotalApplications</td>
                                    <td>@item.AcceptedApplications</td>
                                    <td>@item.CompletedTrainings</td>

                                    <td>
                                        @item.AcceptanceRate.ToString("0.0")%
                                    </td>

                                    <td>
                                        @item.CompletionRate.ToString("0.0")%
                                    </td>

                                    <td>
                                        <i class="bi bi-star-fill text-warning me-1"></i>
                                        @item.AverageRating.ToString("0.0")
                                    </td>

                                    <td>
                                        @item.AverageReviewHours.ToString("0.0") h
                                    </td>

                                    <td>
                                        <div class="quality-cell">
                                            <div class="quality-circle"
                                                 style="--score: @item.QualityScore">
                                                @item.QualityScore
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (!Model.IsAdminView)
                                        {
                                            <a asp-controller="Application"
                                               asp-action="Applicants"
                                               asp-route-internshipId="@item.InternshipId"
                                               class="details-link">
                                                <i class="bi bi-people-fill"></i>
                                                Applicants
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Internship"
                                               asp-action="Details"
                                               asp-route-id="@item.InternshipId"
                                               class="details-link">
                                                <i class="bi bi-eye-fill"></i>
                                                Details
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-analytics">
                    <span>📊</span>

                    <h3>No Analytics Available Yet</h3>

                    <p>
                        Performance data will appear after
                        internships and applications are created.
                    </p>
                </div>
            }
        </section>
    </div>
</div>