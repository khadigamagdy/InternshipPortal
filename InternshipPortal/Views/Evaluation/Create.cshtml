@model InternshipPortal.Models.ViewModels.EvaluationViewModel

@{
    ViewData["Title"] = "Evaluate Student";
}

<style>
    .evaluation-page {
        min-height: 100vh;
        padding: 50px 0;
        background: radial-gradient( circle at top left, rgba(245, 158, 11, 0.18), transparent 35% ), radial-gradient( circle at bottom right, rgba(99, 102, 241, 0.16), transparent 35% );
    }

    .evaluation-container {
        max-width: 850px;
        margin: auto;
    }

    .evaluation-card {
        overflow: hidden;
        border: none;
        border-radius: 28px;
        background: white;
        box-shadow: 0 25px 60px rgba(15, 23, 42, 0.13);
        animation: cardAppear 0.7s ease;
    }

    .evaluation-header {
        position: relative;
        padding: 38px;
        overflow: hidden;
        color: white;
        text-align: center;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed, #0ea5e9 );
    }

        .evaluation-header::before,
        .evaluation-header::after {
            position: absolute;
            content: "";
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

        .evaluation-header::before {
            width: 170px;
            height: 170px;
            top: -90px;
            left: -55px;
        }

        .evaluation-header::after {
            width: 130px;
            height: 130px;
            right: -35px;
            bottom: -65px;
        }

    .header-icon {
        position: relative;
        z-index: 2;
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 17px;
        color: #fef3c7;
        font-size: 40px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.17);
        backdrop-filter: blur(10px);
        animation: floatIcon 2.5s ease-in-out infinite;
    }

    .evaluation-header h1,
    .evaluation-header p {
        position: relative;
        z-index: 2;
    }

    .evaluation-header h1 {
        margin-bottom: 8px;
        font-weight: 900;
    }

    .evaluation-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.82);
    }

    .evaluation-body {
        padding: 40px;
    }

    .student-summary {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        background: #f8fafc;
        transition: 0.3s;
    }

        .summary-item:hover {
            border-color: #a5b4fc;
            background: #eef2ff;
            transform: translateY(-3px);
        }

    .summary-icon {
        min-width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        font-size: 21px;
        font-weight: 900;
        border-radius: 14px;
        background: #e0e7ff;
    }

    .summary-label {
        display: block;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .summary-value {
        display: block;
        color: #0f172a;
        font-weight: 800;
    }

    .form-label {
        margin-bottom: 10px;
        color: #1e293b;
        font-weight: 800;
    }

    .rating-box {
        padding: 28px 20px;
        margin-bottom: 25px;
        text-align: center;
        border: 2px dashed #c7d2fe;
        border-radius: 20px;
        background: linear-gradient( 135deg, #f8fafc, #eef2ff );
    }

    .rating-title {
        margin-bottom: 19px;
        color: #475569;
        font-weight: 700;
    }

    .rating-options {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
    }

    .rating-option {
        position: relative;
    }

        .rating-option input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .rating-option label {
            width: 105px;
            min-height: 108px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 3px;
            color: #94a3b8;
            border: 2px solid #e2e8f0;
            border-radius: 18px;
            background: white;
            cursor: pointer;
            transition: 0.25s;
        }

            .rating-option label:hover {
                color: #d97706;
                border-color: #fbbf24;
                background: #fffbeb;
                transform: translateY(-5px);
                box-shadow: 0 12px 23px rgba(245, 158, 11, 0.16);
            }

        .rating-option input:focus + label {
            outline: 4px solid rgba(99, 102, 241, 0.15);
        }

        .rating-option input:checked + label {
            color: #b45309;
            border-color: #f59e0b;
            background: linear-gradient( 145deg, #fff7d6, #fef3c7 );
            transform: translateY(-5px);
            box-shadow: 0 14px 28px rgba(245, 158, 11, 0.24);
        }

    .rating-star {
        line-height: 1;
        font-size: 39px;
    }

    .rating-number {
        color: #334155;
        font-size: 15px;
        font-weight: 900;
    }

    .rating-description {
        color: #94a3b8;
        font-size: 9px;
        font-weight: 700;
    }

    .rating-option input:checked +
    label .rating-number {
        color: #92400e;
    }

    .rating-option input:checked +
    label .rating-description {
        color: #b45309;
    }

    .selected-rating-message {
        display: none;
        margin: 17px auto 0;
        padding: 9px 15px;
        width: fit-content;
        color: #047857;
        font-size: 12px;
        font-weight: 800;
        border-radius: 20px;
        background: #d1fae5;
    }

        .selected-rating-message.visible {
            display: block;
        }

    .feedback-input {
        min-height: 150px;
        padding: 17px;
        border: 2px solid #e2e8f0;
        border-radius: 17px;
        resize: vertical;
        transition: 0.3s;
    }

        .feedback-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.12);
        }

    .character-count {
        margin-top: 7px;
        color: #94a3b8;
        font-size: 12px;
        text-align: right;
    }

    .validation-summary-errors {
        padding: 15px 20px;
        margin-bottom: 22px;
        color: #b91c1c;
        border: 1px solid #fecaca;
        border-radius: 14px;
        background: #fef2f2;
    }

        .validation-summary-errors ul {
            margin: 0;
        }

    .field-validation-error {
        display: block;
        margin-top: 9px;
        color: #dc2626;
        font-size: 12px;
        font-weight: 700;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .submit-button {
        flex: 1;
        padding: 14px 25px;
        color: white;
        font-weight: 800;
        border: none;
        border-radius: 15px;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
        cursor: pointer;
        transition: 0.3s;
    }

        .submit-button:hover {
            color: white;
            transform: translateY(-4px);
            box-shadow: 0 16px 32px rgba(79, 70, 229, 0.34);
        }

    .cancel-button {
        padding: 14px 25px;
        color: #475569;
        font-weight: 800;
        border: 1px solid #cbd5e1;
        border-radius: 15px;
        background: white;
        transition: 0.3s;
    }

        .cancel-button:hover {
            color: #dc2626;
            border-color: #fecaca;
            background: #fef2f2;
            transform: translateY(-3px);
        }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes floatIcon {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@media (max-width: 768px) {
        .evaluation-body {
            padding: 25px 18px;
        }

        .student-summary {
            grid-template-columns: 1fr;
        }

        .rating-options {
            flex-wrap: wrap;
        }

        .rating-option label {
            width: 90px;
            min-height: 95px;
        }

        .rating-star {
            font-size: 33px;
        }

        .form-actions {
            flex-direction: column;
        }
    }

    @@media (max-width: 480px) {
        .rating-option label {
            width: 75px;
        }

        .evaluation-header {
            padding: 31px 18px;
        }
    }
</style>

<div class="evaluation-page">
    <div class="container">
        <div class="evaluation-container">
            <div class="evaluation-card">
                <div class="evaluation-header">
                    <div class="header-icon">
                        ★
                    </div>

                    <h1>Evaluate Student</h1>

                    <p>
                        Share your feedback about the student's
                        training performance.
                    </p>
                </div>

                <div class="evaluation-body">
                    <div class="student-summary">
                        <div class="summary-item">
                            <div class="summary-icon">
                                S
                            </div>

                            <div>
                                <span class="summary-label">
                                    Student
                                </span>

                                <span class="summary-value">
                                    @Model.StudentName
                                </span>
                            </div>
                        </div>

                        <div class="summary-item">
                            <div class="summary-icon">
                                💼
                            </div>

                            <div>
                                <span class="summary-label">
                                    Internship
                                </span>

                                <span class="summary-value">
                                    @Model.InternshipTitle
                                </span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="InternshipApplicationId"
                               type="hidden" />

                        <input asp-for="StudentName"
                               type="hidden" />

                        <input asp-for="InternshipTitle"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly">
                        </div>

                        <div class="rating-box">
                            <div class="rating-title">
                                Select the student's performance
                                rating
                            </div>

                            <div class="rating-options">
                                <div class="rating-option">
                                    <input asp-for="Rating"
                                           type="radio"
                                           value="1"
                                           id="rating1" />

                                    <label for="rating1"
                                           title="Needs Improvement">
                                        <span class="rating-star">
                                            ★
                                        </span>

                                        <span class="rating-number">
                                            1
                                        </span>

                                        <span class="rating-description">
                                            Needs Improvement
                                        </span>
                                    </label>
                                </div>

                                <div class="rating-option">
                                    <input asp-for="Rating"
                                           type="radio"
                                           value="2"
                                           id="rating2" />

                                    <label for="rating2"
                                           title="Fair">
                                        <span class="rating-star">
                                            ★
                                        </span>

                                        <span class="rating-number">
                                            2
                                        </span>

                                        <span class="rating-description">
                                            Fair
                                        </span>
                                    </label>
                                </div>

                                <div class="rating-option">
                                    <input asp-for="Rating"
                                           type="radio"
                                           value="3"
                                           id="rating3" />

                                    <label for="rating3"
                                           title="Good">
                                        <span class="rating-star">
                                            ★
                                        </span>

                                        <span class="rating-number">
                                            3
                                        </span>

                                        <span class="rating-description">
                                            Good
                                        </span>
                                    </label>
                                </div>

                                <div class="rating-option">
                                    <input asp-for="Rating"
                                           type="radio"
                                           value="4"
                                           id="rating4" />

                                    <label for="rating4"
                                           title="Very Good">
                                        <span class="rating-star">
                                            ★
                                        </span>

                                        <span class="rating-number">
                                            4
                                        </span>

                                        <span class="rating-description">
                                            Very Good
                                        </span>
                                    </label>
                                </div>

                                <div class="rating-option">
                                    <input asp-for="Rating"
                                           type="radio"
                                           value="5"
                                           id="rating5" />

                                    <label for="rating5"
                                           title="Excellent">
                                        <span class="rating-star">
                                            ★
                                        </span>

                                        <span class="rating-number">
                                            5
                                        </span>

                                        <span class="rating-description">
                                            Excellent
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <div class="selected-rating-message"
                                 id="selectedRatingMessage">
                            </div>

                            <span asp-validation-for="Rating">
                            </span>
                        </div>

                        <div>
                            <label asp-for="Feedback"
                                   class="form-label">
                                Performance Feedback
                            </label>

                            <textarea asp-for="Feedback"
                                      class="form-control feedback-input"
                                      id="feedbackInput"
                                      maxlength="1000"
                                      placeholder="Write your feedback about the student's skills, commitment, teamwork and overall performance..."></textarea>

                            <div class="character-count">
                                <span id="characterCount">0</span>
                                / 1000 characters
                            </div>

                            <span asp-validation-for="Feedback">
                            </span>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="submit-button">
                                ✓ Submit Evaluation
                            </button>

                            <a asp-controller="Internship"
                               asp-action="MyInternships"
                               class="cancel-button text-decoration-none text-center">
                                ← Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const feedbackInput =
            document.getElementById("feedbackInput");

        const characterCount =
            document.getElementById("characterCount");

        const ratingInputs =
            document.querySelectorAll(
                'input[name="Rating"]');

        const selectedRatingMessage =
            document.getElementById(
                "selectedRatingMessage");

        function updateCharacterCount() {
            if (!feedbackInput ||
                !characterCount) {
                return;
            }

            characterCount.textContent =
                feedbackInput.value.length;
        }

        function updateSelectedRating() {
            const selectedRating =
                document.querySelector(
                    'input[name="Rating"]:checked');

            if (!selectedRating ||
                !selectedRatingMessage) {
                return;
            }

            let description = "";

            switch (selectedRating.value) {
                case "1":
                    description =
                        "Needs Improvement";
                    break;

                case "2":
                    description =
                        "Fair";
                    break;

                case "3":
                    description =
                        "Good";
                    break;

                case "4":
                    description =
                        "Very Good";
                    break;

                case "5":
                    description =
                        "Excellent";
                    break;
            }

            selectedRatingMessage.textContent =
                "Selected rating: " +
                selectedRating.value +
                " out of 5 — " +
                description;

            selectedRatingMessage
                .classList
                .add("visible");
        }

        if (feedbackInput) {
            feedbackInput.addEventListener(
                "input",
                updateCharacterCount);
        }

        ratingInputs.forEach(function(input) {
            input.addEventListener(
                "change",
                updateSelectedRating);
        });

        updateCharacterCount();
        updateSelectedRating();
    </script>
}