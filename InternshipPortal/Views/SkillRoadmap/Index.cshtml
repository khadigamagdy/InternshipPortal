@model IEnumerable<InternshipPortal.Models.SkillDevelopmentPlan>
@using InternshipPortal.Models.Enums

@{
    ViewData["Title"] = "My Skill Roadmaps";

    var plans = Model.ToList();
    var completedPlans = plans.Count(plan => plan.IsCompleted);
    var activePlans = plans.Count - completedPlans;
}

<style>
    .roadmaps-page {
        min-height: 100vh;
        padding: 45px 0;
        background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.14), transparent 35%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.13), transparent 35%), #f8fafc;
    }

    .roadmaps-header {
        position: relative;
        overflow: hidden;
        padding: 38px;
        margin-bottom: 24px;
        color: white;
        border-radius: 27px;
        background: linear-gradient(135deg, #312e81, #7c3aed, #0284c7);
        box-shadow: 0 21px 47px rgba(76, 29, 149, 0.24);
        animation: roadmapAppear 0.7s ease;
    }

        .roadmaps-header::after {
            position: absolute;
            width: 250px;
            height: 250px;
            right: -70px;
            bottom: -155px;
            content: "";
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .header-main {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .header-icon {
        min-width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        border-radius: 21px;
        background: rgba(255, 255, 255, 0.16);
        animation: iconFloat 3s ease-in-out infinite;
    }

    .roadmaps-header h1 {
        margin: 0;
        font-weight: 900;
    }

    .roadmaps-header p {
        margin: 7px 0 0;
        color: rgba(255, 255, 255, 0.83);
    }

    .matches-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        color: #4c1d95;
        font-weight: 800;
        border-radius: 13px;
        background: white;
        text-decoration: none;
        transition: 0.3s;
    }

        .matches-button:hover {
            color: #4c1d95;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(15, 23, 42, 0.2);
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
        margin-bottom: 25px;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 19px;
        background: white;
        box-shadow: 0 9px 25px rgba(15, 23, 42, 0.07);
    }

    .summary-icon {
        min-width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        border-radius: 16px;
    }

    .purple-icon {
        color: #6d28d9;
        background: #ede9fe;
    }

    .orange-icon {
        color: #c2410c;
        background: #ffedd5;
    }

    .green-icon {
        color: #047857;
        background: #d1fae5;
    }

    .summary-number {
        display: block;
        color: #0f172a;
        font-size: 26px;
        font-weight: 900;
    }

    .summary-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .plan-card {
        position: relative;
        overflow: hidden;
        padding: 24px;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: white;
        box-shadow: 0 11px 29px rgba(15, 23, 42, 0.07);
        transition: 0.35s;
        animation: cardAppear 0.6s ease both;
    }

        .plan-card:hover {
            border-color: #c4b5fd;
            transform: translateY(-6px);
            box-shadow: 0 19px 39px rgba(109, 40, 217, 0.14);
        }

        .plan-card::before {
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            content: "";
            background: linear-gradient(#7c3aed, #0284c7);
        }

    .plan-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
    }

    .company-area {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .company-logo {
        min-width: 57px;
        height: 57px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: white;
        font-size: 22px;
        font-weight: 900;
        border-radius: 17px;
        background: linear-gradient(135deg, #7c3aed, #0284c7);
    }

        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .plan-title {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 17px;
        font-weight: 900;
    }

    .company-name {
        color: #6366f1;
        font-size: 12px;
        font-weight: 800;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        font-size: 11px;
        font-weight: 800;
        border-radius: 20px;
        white-space: nowrap;
    }

    .active-status {
        color: #b45309;
        background: #fef3c7;
    }

    .completed-status {
        color: #047857;
        background: #d1fae5;
    }

    .plan-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 18px 0;
    }

    .detail-chip {
        padding: 6px 10px;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        border-radius: 20px;
        background: #f1f5f9;
    }

    .progress-heading {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        color: #475569;
        font-size: 12px;
        font-weight: 800;
    }

    .progress-track {
        height: 9px;
        overflow: hidden;
        border-radius: 20px;
        background: #e2e8f0;
    }

    .progress-value {
        display: block;
        height: 100%;
        border-radius: 20px;
        background: linear-gradient(90deg, #7c3aed, #06b6d4);
        animation: progressGrow 1.2s ease;
    }

    .skills-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 17px;
    }

    .skill-chip {
        padding: 6px 9px;
        color: #5b21b6;
        font-size: 10px;
        font-weight: 800;
        border-radius: 18px;
        background: #ede9fe;
    }

    .plan-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 19px;
        padding-top: 17px;
        border-top: 1px solid #f1f5f9;
    }

    .open-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 16px;
        color: white;
        font-size: 12px;
        font-weight: 800;
        border-radius: 12px;
        background: linear-gradient(135deg, #7c3aed, #0284c7);
        text-decoration: none;
        transition: 0.3s;
    }

        .open-button:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(124, 58, 237, 0.25);
        }

    .empty-state {
        grid-column: 1 / -1;
        padding: 80px 25px;
        text-align: center;
        border: 2px dashed #cbd5e1;
        border-radius: 25px;
        background: white;
    }

    .empty-icon {
        font-size: 75px;
        animation: iconFloat 3s ease-in-out infinite;
    }

    .empty-state h3 {
        margin-top: 17px;
        color: #0f172a;
        font-weight: 900;
    }

    .empty-state p {
        color: #64748b;
    }

    @@keyframes roadmapAppear {
        from {
            opacity: 0;
            transform: translateY(-25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes progressGrow {
        from {
            width: 0;
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0) rotate(0);
        }

        50% {
            transform: translateY(-7px) rotate(5deg);
        }
    }

    @@media (max-width: 900px) {
        .plans-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .header-content,
        .plan-top {
            flex-direction: column;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .matches-button {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="roadmaps-page">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="roadmaps-header">
            <div class="header-content">
                <div class="header-main">
                    <div class="header-icon">
                        <i class="bi bi-signpost-split-fill"></i>
                    </div>

                    <div>
                        <h1>My Skill Roadmaps</h1>
                        <p>
                            Turn skill gaps into practical learning plans
                            and track your career readiness.
                        </p>
                    </div>
                </div>

                <a asp-controller="Matching"
                   asp-action="Index"
                   class="matches-button">
                    <i class="bi bi-stars"></i>
                    Find New Matches
                </a>
            </div>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-icon purple-icon">
                    <i class="bi bi-map-fill"></i>
                </div>

                <div>
                    <span class="summary-number">@plans.Count</span>
                    <span class="summary-label">Total Roadmaps</span>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon orange-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>

                <div>
                    <span class="summary-number">@activePlans</span>
                    <span class="summary-label">Active Roadmaps</span>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon green-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div>
                    <span class="summary-number">@completedPlans</span>
                    <span class="summary-label">Completed Roadmaps</span>
                </div>
            </div>
        </div>

        <div class="plans-grid">
            @if (!plans.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🗺️</div>

                    <h3>No Development Roadmaps Yet</h3>

                    <p>
                        Open your smart matches and generate a personalized
                        roadmap for any internship.
                    </p>

                    <a asp-controller="Matching"
                       asp-action="Index"
                       class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-stars me-1"></i>
                        View Smart Matches
                    </a>
                </div>
            }
            else
            {
                var animationDelay = 0;

                foreach (var plan in plans)
                {
                    var totalItems = plan.Items.Count;

                    var completedItems = plan.Items.Count(item =>
                    item.Status == SkillProgressStatus.Completed);

                    var progress = totalItems == 0
                    ? 0
                    : (int)Math.Round(
                    plan.Items.Average(item =>
                    item.ProgressPercentage));

                    <article class="plan-card"
                             style="animation-delay: @(animationDelay)ms">

                        <div class="plan-top">
                            <div class="company-area">
                                <div class="company-logo">
                                    @if (!string.IsNullOrWhiteSpace(
                                                                plan.Internship.Company.LogoPath))
                                    {
                                        <img src="@plan.Internship.Company.LogoPath"
                                             alt="@plan.Internship.Company.Name" />
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(
                                                                    plan.Internship.Company.Name)
                                                                    ? "C"
                                                                    : plan.Internship.Company.Name
                                                                    .Substring(0, 1)
                                                                    .ToUpper())
                                                        }
                                </div>

                                <div>
                                    <h3 class="plan-title">@plan.Title</h3>

                                    <span class="company-name">
                                        <i class="bi bi-building-fill me-1"></i>
                                        @plan.Internship.Company.Name
                                    </span>
                                </div>
                            </div>

                            @if (plan.IsCompleted)
                            {
                                <span class="status-badge completed-status">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="status-badge active-status">
                                    <i class="bi bi-hourglass-split"></i>
                                    In Progress
                                </span>
                            }
                        </div>

                        <div class="plan-details">
                            <span class="detail-chip">
                                <i class="bi bi-list-check me-1"></i>
                                @completedItems of @totalItems skills
                            </span>

                            <span class="detail-chip">
                                <i class="bi bi-calendar3 me-1"></i>
                                Created @plan.CreatedAt.ToString("dd MMM yyyy")
                            </span>

                            @if (plan.TargetCompletionDate.HasValue)
                            {
                                <span class="detail-chip">
                                    <i class="bi bi-flag-fill me-1"></i>
                                    Target
                                    @plan.TargetCompletionDate.Value
                                    .ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>

                        <div class="progress-heading">
                            <span>Overall progress</span>
                            <span>@progress%</span>
                        </div>

                        <div class="progress-track">
                            <span class="progress-value"
                                  style="width: @progress%">
                            </span>
                        </div>

                        <div class="skills-preview">
                            @foreach (var item in plan.Items.Take(5))
                            {
                                <span class="skill-chip">
                                    @if (item.Status ==
                                                            SkillProgressStatus.Completed)
                                    {
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                    }

                                    @item.SkillName
                                </span>
                            }

                            @if (plan.Items.Count > 5)
                            {
                                <span class="skill-chip">
                                    +@(plan.Items.Count - 5) more
                                </span>
                            }
                        </div>

                        <div class="plan-actions">
                            <a asp-action="Details"
                               asp-route-id="@plan.Id"
                               class="open-button">
                                <i class="bi bi-arrow-right-circle-fill"></i>
                                Open Roadmap
                            </a>
                        </div>
                    </article>

                    animationDelay += 90;
                }
            }
        </div>
    </div>
</div>