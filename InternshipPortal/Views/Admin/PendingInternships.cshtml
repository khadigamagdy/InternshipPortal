@model List<InternshipPortal.Models.Internship>

@{
    ViewData["Title"] = "Pending Internships";
}

<div class="review-page">
    <div class="review-container">

        @if (TempData["Success"] != null)
        {
            <div class="success-alert">
                <span>✓</span>
                @TempData["Success"]
            </div>
        }

        <section class="review-header">
            <div>
                <span class="admin-badge">
                    Administrator Panel
                </span>

                <h1>Review Internships</h1>

                <p>
                    Review internship information before
                    publishing it to students.
                </p>
            </div>

            <div class="header-stat">
                <span>⏳</span>

                <div>
                    <strong>@Model.Count</strong>
                    <small>Pending Reviews</small>
                </div>
            </div>
        </section>

        <section class="review-navigation">
            <div>
                <h2>Pending Opportunities</h2>

                <p>
                    Approve valid opportunities or reject
                    incomplete listings.
                </p>
            </div>

            <div class="navigation-actions">
                <a asp-controller="Admin"
                   asp-action="AllInternships"
                   class="all-button">
                    All Internships
                </a>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="dashboard-button">
                    Dashboard
                </a>
            </div>
        </section>

        @if (Model.Any())
        {
            <section class="pending-list">
                @foreach (var internship in Model)
                {
                    <article class="pending-card">
                        <div class="company-section">
                            <div class="company-logo">
                                @if (!string.IsNullOrEmpty(
                                    internship.Company.LogoPath))
                                {
                                    <img src="@internship.Company.LogoPath"
                                         alt="@internship.Company.Name" />
                                }
                                else
                                {
                                    <span>🏢</span>
                                }
                            </div>

                            <div>
                                <span class="waiting-badge">
                                    Waiting for Review
                                </span>

                                <h2>@internship.Title</h2>

                                <p class="company-name">
                                    @internship.Company.Name
                                </p>
                            </div>

                            <span class="work-mode">
                                @internship.WorkMode
                            </span>
                        </div>

                        <p class="description">
                            @internship.Description
                        </p>

                        <div class="information-grid">
                            <div>
                                <span>📍</span>

                                <small>Location</small>

                                <strong>
                                    @internship.Location
                                </strong>
                            </div>

                            <div>
                                <span>👥</span>

                                <small>Positions</small>

                                <strong>
                                    @internship.AvailablePositions
                                </strong>
                            </div>

                            <div>
                                <span>📅</span>

                                <small>Deadline</small>

                                <strong>
                                    @internship.ApplicationDeadline
                                    .ToString("dd MMM yyyy")
                                </strong>
                            </div>

                            <div>
                                <span>💰</span>

                                <small>Payment</small>

                                <strong>
                                    @if (internship.IsPaid)
                                    {
                                        <text>
                                            @internship.Salary?
                                            .ToString("N0")
                                            EGP
                                        </text>
                                    }
                                    else
                                    {
                                        <text>Unpaid</text>
                                    }
                                </strong>
                            </div>
                        </div>

                        <div class="skills-section">
                            <strong>Required Skills</strong>

                            <p>@internship.RequiredSkills</p>
                        </div>

                        <div class="card-footer">
                            <div class="submission-date">
                                Submitted on
                                @internship.CreatedAt
                                .ToString("dd MMMM yyyy")
                            </div>

                            <div class="review-actions">
                                <a asp-controller="Internship"
                                   asp-action="Details"
                                   asp-route-id="@internship.Id"
                                   class="details-button">
                                    View Details
                                </a>

                                <form asp-controller="Admin"
                                      asp-action="RejectInternship"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@internship.Id" />

                                    <button type="submit"
                                            class="reject-button"
                                            onclick="return confirm('Reject this internship?')">
                                        Reject
                                    </button>
                                </form>

                                <form asp-controller="Admin"
                                      asp-action="ApproveInternship"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@internship.Id" />

                                    <button type="submit"
                                            class="approve-button">
                                        ✓ Approve
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="empty-review">
                <div class="empty-icon">✅</div>

                <h2>All Caught Up!</h2>

                <p>
                    There are no internship opportunities
                    waiting for review.
                </p>

                <a asp-controller="Admin"
                   asp-action="AllInternships">
                    View All Internships
                </a>
            </section>
        }
    </div>
</div>

<style>
    .review-page {
        min-height: 100vh;
        padding: 40px 20px 70px;
        background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.09), transparent 30%), radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.08), transparent 35%), #f5f7fb;
    }

    .review-container {
        max-width: 1150px;
        margin: auto;
    }

    .success-alert {
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #047857;
        border: 1px solid #a7f3d0;
        border-radius: 13px;
        background: #ecfdf5;
        font-size: 12px;
        font-weight: 700;
    }

    .review-header {
        padding: 36px 42px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        border-radius: 25px;
        background: linear-gradient(135deg, #312e81, #6d28d9 55%, #2563eb);
        box-shadow: 0 20px 46px rgba(109, 40, 217, 0.2);
        animation: reviewEntrance 0.7s ease;
    }

    .admin-badge {
        display: inline-block;
        padding: 5px 12px;
        margin-bottom: 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.17);
        font-size: 10px;
    }

    .review-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 800;
    }

    .review-header p {
        margin: 9px 0 0;
        color: #e0e7ff;
        font-size: 12px;
    }

    .header-stat {
        padding: 16px 21px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
    }

        .header-stat > span {
            font-size: 30px;
        }

        .header-stat strong,
        .header-stat small {
            display: block;
        }

        .header-stat strong {
            font-size: 24px;
        }

        .header-stat small {
            color: #e0e7ff;
            font-size: 9px;
        }

    .review-navigation {
        padding: 22px 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .review-navigation h2 {
            margin: 0;
            color: #172554;
            font-size: 20px;
            font-weight: 800;
        }

        .review-navigation p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 10px;
        }

    .navigation-actions {
        display: flex;
        gap: 8px;
    }

    .all-button,
    .dashboard-button {
        padding: 8px 12px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .all-button {
        color: #6d28d9;
        background: #ede9fe;
    }

    .dashboard-button {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .pending-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .pending-card {
        padding: 25px;
        border: 1px solid #e7e5ff;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        transition: 0.35s;
        animation: reviewEntrance 0.8s ease;
    }

        .pending-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 37px rgba(109, 40, 217, 0.1);
        }

    .company-section {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
    }

    .company-logo {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 3px solid #ede9fe;
        border-radius: 17px;
        background: #f5f3ff;
    }

        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .company-logo span {
            font-size: 29px;
        }

    .waiting-badge {
        padding: 4px 8px;
        color: #b45309;
        border-radius: 20px;
        background: #fef3c7;
        font-size: 8px;
        font-weight: 800;
    }

    .company-section h2 {
        margin: 8px 0 2px;
        color: #172554;
        font-size: 18px;
        font-weight: 800;
    }

    .company-name {
        margin: 0;
        color: #6d28d9;
        font-size: 10px;
        font-weight: 700;
    }

    .work-mode {
        padding: 6px 10px;
        color: #1d4ed8;
        border-radius: 20px;
        background: #dbeafe;
        font-size: 9px;
        font-weight: 800;
    }

    .description {
        margin: 18px 0;
        color: #64748b;
        line-height: 1.7;
        font-size: 11px;
    }

    .information-grid {
        padding: 17px 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid #eef2f7;
        border-bottom: 1px solid #eef2f7;
    }

        .information-grid > div {
            padding: 0 13px;
            display: grid;
            grid-template-columns: auto 1fr;
            column-gap: 8px;
            border-right: 1px solid #eef2f7;
        }

            .information-grid > div:last-child {
                border-right: none;
            }

            .information-grid > div > span {
                grid-row: 1 / 3;
                align-self: center;
                font-size: 20px;
            }

        .information-grid small,
        .information-grid strong {
            display: block;
        }

        .information-grid small {
            color: #94a3b8;
            font-size: 8px;
        }

        .information-grid strong {
            margin-top: 3px;
            color: #334155;
            font-size: 10px;
        }

    .skills-section {
        padding: 12px 14px;
        margin-top: 15px;
        border-radius: 11px;
        background: #f8fafc;
    }

        .skills-section strong {
            color: #334155;
            font-size: 9px;
        }

        .skills-section p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 9px;
        }

    .card-footer {
        margin-top: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .submission-date {
        color: #94a3b8;
        font-size: 9px;
    }

    .review-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .review-actions form {
            margin: 0;
        }

    .details-button,
    .reject-button,
    .approve-button {
        padding: 8px 13px;
        border: none;
        border-radius: 9px;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        transition: 0.3s;
    }

    .details-button {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .reject-button {
        color: #b91c1c;
        background: #fee2e2;
    }

    .approve-button {
        color: white;
        background: linear-gradient(90deg, #059669, #10b981);
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.2);
    }

        .details-button:hover,
        .reject-button:hover,
        .approve-button:hover {
            transform: translateY(-2px);
        }

    .empty-review {
        padding: 75px 20px;
        text-align: center;
        border: 2px dashed #c4b5fd;
        border-radius: 22px;
        background: white;
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: #d1fae5;
        font-size: 40px;
    }

    .empty-review h2 {
        margin: 18px 0 7px;
        color: #172554;
        font-size: 21px;
        font-weight: 800;
    }

    .empty-review p {
        color: #64748b;
        font-size: 11px;
    }

    .empty-review a {
        display: inline-block;
        padding: 10px 15px;
        margin-top: 12px;
        color: white;
        border-radius: 10px;
        background: #6d28d9;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    @@keyframes reviewEntrance {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 750px) {
        .review-header {
            padding: 30px 23px;
            align-items: flex-start;
            flex-direction: column;
            gap: 20px;
        }

        .review-navigation {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .company-section {
            grid-template-columns: auto 1fr;
        }

        .work-mode {
            grid-column: 1 / 3;
            width: fit-content;
        }

        .information-grid {
            grid-template-columns: 1fr 1fr;
            gap: 15px 0;
        }

        .card-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 14px;
        }

        .review-actions {
            flex-wrap: wrap;
        }
    }
</style>