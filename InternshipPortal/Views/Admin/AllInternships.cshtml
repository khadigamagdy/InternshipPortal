@model List<InternshipPortal.Models.Internship>

@{
    ViewData["Title"] = "All Internships";
}

<div class="all-page">
    <div class="all-container">

        @if (TempData["Success"] != null)
        {
            <div class="success-alert">
                <span>✓</span>
                @TempData["Success"]
            </div>
        }

        <section class="all-header">
            <div>
                <span class="admin-badge">
                    Administrator Panel
                </span>

                <h1>All Internships</h1>

                <p>
                    Monitor and manage all internship
                    opportunities on the platform.
                </p>
            </div>

            <div class="header-icon">
                📊
            </div>
        </section>

        <section class="statistics-grid">
            <div class="statistics-card">
                <span class="statistics-icon blue-icon">
                    💼
                </span>

                <div>
                    <strong>@Model.Count</strong>
                    <small>Total Internships</small>
                </div>
            </div>

            <div class="statistics-card">
                <span class="statistics-icon green-icon">
                    ✓
                </span>

                <div>
                    <strong>
                        @Model.Count(i => i.IsApproved)
                    </strong>

                    <small>Approved</small>
                </div>
            </div>

            <div class="statistics-card">
                <span class="statistics-icon orange-icon">
                    ⏳
                </span>

                <div>
                    <strong>
                        @Model.Count(i =>
                            !i.IsApproved && i.IsActive)
                    </strong>

                    <small>Pending</small>
                </div>
            </div>

            <div class="statistics-card">
                <span class="statistics-icon red-icon">
                    ✕
                </span>

                <div>
                    <strong>
                        @Model.Count(i => !i.IsActive)
                    </strong>

                    <small>Inactive or Rejected</small>
                </div>
            </div>
        </section>

        <section class="table-card">
            <div class="table-heading">
                <div>
                    <h2>Internship Management</h2>

                    <p>
                        View details and control opportunity status.
                    </p>
                </div>

                <a asp-controller="Admin"
                   asp-action="PendingInternships"
                   class="pending-button">
                    Review Pending
                </a>
            </div>

            @if (Model.Any())
            {
                <div class="responsive-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Internship</th>
                                <th>Company</th>
                                <th>Work Mode</th>
                                <th>Deadline</th>
                                <th>Approval</th>
                                <th>Activity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var internship in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="internship-cell">
                                            <div class="internship-icon">
                                                💼
                                            </div>

                                            <div>
                                                <strong>
                                                    @internship.Title
                                                </strong>

                                                <small>
                                                    @internship.Location
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="company-cell">
                                            @if (!string.IsNullOrEmpty(
                                                internship.Company.LogoPath))
                                            {
                                                <img src="@internship.Company.LogoPath"
                                                     alt="@internship.Company.Name" />
                                            }
                                            else
                                            {
                                                <span>🏢</span>
                                            }

                                            <strong>
                                                @internship.Company.Name
                                            </strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="mode-badge">
                                            @internship.WorkMode
                                        </span>
                                    </td>

                                    <td>
                                        <span class="date-text">
                                            @internship.ApplicationDeadline
                                            .ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        @if (internship.IsApproved)
                                        {
                                            <span class="status approved">
                                                Approved
                                            </span>
                                        }
                                        else if (!internship.IsActive)
                                        {
                                            <span class="status rejected">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status pending">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (internship.IsActive)
                                        {
                                            <span class="status active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status inactive">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="actions-cell">
                                            <a asp-controller="Internship"
                                               asp-action="Details"
                                               asp-route-id="@internship.Id"
                                               class="details-button">
                                                Details
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="ChangeActiveStatus"
                                                  method="post">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@internship.Id" />

                                                @if (internship.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="deactivate-button">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="activate-button">
                                                        Activate
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <span>💼</span>

                    <h2>No Internships Yet</h2>

                    <p>
                        Internship opportunities will appear here.
                    </p>
                </div>
            }
        </section>
    </div>
</div>

<style>
    .all-page {
        min-height: 100vh;
        padding: 40px 20px 70px;
        background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.09), transparent 30%), radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.08), transparent 35%), #f5f7fb;
    }

    .all-container {
        max-width: 1300px;
        margin: auto;
    }

    .success-alert {
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #047857;
        border: 1px solid #a7f3d0;
        border-radius: 13px;
        background: #ecfdf5;
        font-size: 12px;
        font-weight: 700;
    }

    .all-header {
        padding: 35px 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white;
        border-radius: 25px;
        background: linear-gradient(135deg, #312e81, #6d28d9 55%, #2563eb);
        box-shadow: 0 20px 46px rgba(109, 40, 217, 0.2);
        animation: tableEntrance 0.7s ease;
    }

    .admin-badge {
        display: inline-block;
        padding: 5px 12px;
        margin-bottom: 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.17);
        font-size: 10px;
    }

    .all-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 800;
    }

    .all-header p {
        margin: 9px 0 0;
        color: #e0e7ff;
        font-size: 12px;
    }

    .header-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.16);
        font-size: 38px;
        animation: iconFloat 4s ease-in-out infinite;
    }

    .statistics-grid {
        margin-top: 21px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .statistics-card {
        padding: 19px;
        display: flex;
        align-items: center;
        gap: 13px;
        border: 1px solid #e6ebf2;
        border-radius: 17px;
        background: white;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        transition: 0.3s;
    }

        .statistics-card:hover {
            transform: translateY(-5px);
        }

    .statistics-icon {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 22px;
    }

    .blue-icon {
        background: #dbeafe;
    }

    .green-icon {
        background: #d1fae5;
    }

    .orange-icon {
        background: #fef3c7;
    }

    .red-icon {
        background: #fee2e2;
    }

    .statistics-card strong,
    .statistics-card small {
        display: block;
    }

    .statistics-card strong {
        color: #172554;
        font-size: 22px;
        font-weight: 800;
    }

    .statistics-card small {
        margin-top: 2px;
        color: #64748b;
        font-size: 9px;
    }

    .table-card {
        padding: 27px;
        margin-top: 21px;
        border: 1px solid #e6ebf2;
        border-radius: 21px;
        background: white;
        box-shadow: 0 11px 32px rgba(15, 23, 42, 0.05);
        animation: tableEntrance 0.8s ease;
    }

    .table-heading {
        padding-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eef2f7;
    }

        .table-heading h2 {
            margin: 0;
            color: #172554;
            font-size: 19px;
            font-weight: 800;
        }

        .table-heading p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 10px;
        }

    .pending-button {
        padding: 9px 13px;
        color: white;
        border-radius: 9px;
        background: linear-gradient(90deg, #7c3aed, #2563eb);
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .responsive-table {
        margin-top: 10px;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        padding: 13px 10px;
        color: #94a3b8;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
        white-space: nowrap;
        font-size: 9px;
    }

    td {
        padding: 15px 10px;
        color: #475569;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 10px;
    }

    .internship-cell,
    .company-cell {
        min-width: 150px;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .internship-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #dbeafe;
        font-size: 18px;
    }

    .internship-cell strong,
    .internship-cell small {
        display: block;
    }

    .internship-cell strong {
        color: #1e293b;
        font-size: 10px;
    }

    .internship-cell small {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 8px;
    }

    .company-cell img,
    .company-cell > span {
        width: 33px;
        height: 33px;
        flex-shrink: 0;
        border-radius: 9px;
    }

    .company-cell img {
        object-fit: cover;
    }

    .company-cell > span {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        font-size: 17px;
    }

    .company-cell strong {
        color: #334155;
        font-size: 9px;
    }

    .mode-badge {
        padding: 5px 8px;
        color: #6d28d9;
        border-radius: 20px;
        background: #ede9fe;
        white-space: nowrap;
        font-size: 8px;
        font-weight: 800;
    }

    .date-text {
        white-space: nowrap;
        font-size: 9px;
    }

    .status {
        display: inline-block;
        padding: 5px 8px;
        border-radius: 20px;
        white-space: nowrap;
        font-size: 8px;
        font-weight: 800;
    }

    .approved,
    .active {
        color: #047857;
        background: #d1fae5;
    }

    .pending {
        color: #b45309;
        background: #fef3c7;
    }

    .rejected {
        color: #b91c1c;
        background: #fee2e2;
    }

    .inactive {
        color: #475569;
        background: #e2e8f0;
    }

    .actions-cell {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .actions-cell form {
            margin: 0;
        }

    .details-button,
    .deactivate-button,
    .activate-button {
        padding: 6px 9px;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        font-size: 8px;
        font-weight: 800;
        transition: 0.3s;
    }

    .details-button {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .deactivate-button {
        color: #b91c1c;
        background: #fee2e2;
    }

    .activate-button {
        color: #047857;
        background: #d1fae5;
    }

        .details-button:hover,
        .deactivate-button:hover,
        .activate-button:hover {
            transform: translateY(-2px);
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

        .empty-state > span {
            display: block;
            font-size: 45px;
        }

        .empty-state h2 {
            margin: 14px 0 5px;
            color: #172554;
            font-size: 20px;
        }

        .empty-state p {
            color: #94a3b8;
            font-size: 10px;
        }

    @@keyframes tableEntrance {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0) rotate(-4deg);
        }

        50% {
            transform: translateY(-8px) rotate(4deg);
        }
    }

    @@media (max-width: 900px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .all-header {
            padding: 30px 23px;
        }

        .header-icon {
            display: none;
        }

        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .table-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 13px;
        }

        .table-card {
            padding: 20px 13px;
        }
    }
</style>