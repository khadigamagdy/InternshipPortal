@model InternshipPortal.Models.ViewModels.InternshipFormViewModel
@using InternshipPortal.Models.Enums

@{
    ViewData["Title"] = "Edit Internship";
}

<div class="internship-form-page">
    <div class="internship-form-container">

        <section class="form-banner">
            <div>
                <span class="banner-badge">
                    Update Opportunity
                </span>

                <h1>Edit Internship</h1>

                <p>
                    Update the internship information
                    and submit it for approval again.
                </p>
            </div>

            <div class="banner-icon">
                ✏️
            </div>
        </section>

        <section class="internship-form-card">
            <div class="form-card-header">
                <div>
                    <h2>Update Internship Information</h2>

                    <p>
                        All changes will be reviewed by
                        the administrator before publishing.
                    </p>
                </div>

                <a asp-controller="Internship"
                   asp-action="MyInternships"
                   class="back-button">
                    ← My Internships
                </a>
            </div>

            <form asp-controller="Internship"
                  asp-action="Edit"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary text-danger">
                </div>

                <div class="form-group">
                    <label asp-for="Title">
                        Internship Title *
                    </label>

                    <input asp-for="Title"
                           class="internship-input"
                           placeholder="Example: ASP.NET Developer Intern" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description">
                        Description *
                    </label>

                    <textarea asp-for="Description"
                              class="internship-input large-textarea"
                              placeholder="Describe the internship responsibilities and learning outcomes...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RequiredSkills">
                        Required Skills *
                    </label>

                    <textarea asp-for="RequiredSkills"
                              class="internship-input skills-textarea"
                              placeholder="Example: C#, SQL Server, HTML, CSS and ASP.NET MVC">
                    </textarea>

                    <span asp-validation-for="RequiredSkills"
                          class="text-danger"></span>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Location">
                            Location *
                        </label>

                        <input asp-for="Location"
                               class="internship-input"
                               placeholder="Damietta, Egypt" />

                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="WorkMode">
                            Work Mode *
                        </label>

                        <select asp-for="WorkMode"
                                asp-items="Html.GetEnumSelectList<WorkMode>()"
                                class="internship-input">
                        </select>

                        <span asp-validation-for="WorkMode"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="section-divider">
                    <span>Internship Schedule</span>
                </div>

                <div class="dates-grid">
                    <div class="form-group">
                        <label asp-for="ApplicationDeadline">
                            Application Deadline *
                        </label>

                        <input asp-for="ApplicationDeadline"
                               type="date"
                               class="internship-input" />

                        <span asp-validation-for="ApplicationDeadline"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StartDate">
                            Start Date *
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="internship-input" />

                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EndDate">
                            End Date *
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="internship-input" />

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="section-divider">
                    <span>Positions & Payment</span>
                </div>

                <div class="payment-grid">
                    <div class="form-group">
                        <label asp-for="AvailablePositions">
                            Available Positions *
                        </label>

                        <input asp-for="AvailablePositions"
                               type="number"
                               min="1"
                               class="internship-input" />

                        <span asp-validation-for="AvailablePositions"
                              class="text-danger"></span>
                    </div>

                    <div class="paid-option">
                        <label class="switch-label">
                            <input asp-for="IsPaid"
                                   id="paidCheckbox"
                                   type="checkbox" />

                            <span class="custom-switch"></span>

                            <span>
                                <strong>Paid Internship</strong>

                                <small>
                                    Enable this if the internship
                                    offers a salary.
                                </small>
                            </span>
                        </label>
                    </div>

                    <div class="form-group"
                         id="salaryGroup">

                        <label asp-for="Salary">
                            Monthly Salary
                        </label>

                        <div class="salary-input-wrapper">
                            <input asp-for="Salary"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="internship-input"
                                   placeholder="5000" />

                            <span>EGP</span>
                        </div>

                        <span asp-validation-for="Salary"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="approval-note">
                    <span>🛡️</span>

                    <div>
                        <strong>Administrative Review</strong>

                        <p>
                            After editing, the internship will return
                            to pending status until the administrator
                            approves it again.
                        </p>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Internship"
                       asp-action="MyInternships"
                       class="cancel-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="save-button">
                        Save Changes
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

<style>
    .internship-form-page {
        min-height: 100vh;
        padding: 40px 20px 70px;
        background: radial-gradient(circle at top left, rgba(2, 132, 199, 0.1), transparent 30%), radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.09), transparent 35%), #f5f7fb;
    }

    .internship-form-container {
        max-width: 1050px;
        margin: auto;
    }

    .form-banner {
        padding: 35px 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white;
        border-radius: 25px;
        background: linear-gradient(135deg, #082f49, #0369a1 55%, #6d28d9);
        box-shadow: 0 20px 45px rgba(3, 105, 161, 0.2);
        animation: formEntrance 0.7s ease;
    }

    .banner-badge {
        display: inline-block;
        padding: 5px 12px;
        margin-bottom: 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.16);
        font-size: 11px;
    }

    .form-banner h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 800;
    }

    .form-banner p {
        margin: 9px 0 0;
        color: #e0f2fe;
        font-size: 13px;
    }

    .banner-icon {
        width: 85px;
        height: 85px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.17);
        font-size: 42px;
        animation: editFloat 4s ease-in-out infinite;
    }

    .internship-form-card {
        padding: 35px;
        margin-top: 23px;
        border: 1px solid #e6ebf2;
        border-radius: 22px;
        background: white;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
        animation: formEntrance 0.8s ease;
    }

    .form-card-header {
        padding-bottom: 22px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #edf1f6;
    }

        .form-card-header h2 {
            margin: 0;
            color: #172554;
            font-size: 21px;
            font-weight: 800;
        }

        .form-card-header p {
            margin: 5px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

    .back-button {
        padding: 9px 14px;
        color: #0369a1;
        border-radius: 10px;
        background: #e0f2fe;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: 0.3s;
    }

        .back-button:hover {
            color: #0369a1;
            transform: translateY(-2px);
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 12px;
            font-weight: 700;
        }

    .internship-input {
        width: 100%;
        height: 49px;
        padding: 0 14px;
        color: #334155;
        outline: none;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #fbfdff;
        transition: 0.3s;
    }

    .large-textarea {
        min-height: 145px;
        padding: 13px 14px;
        resize: vertical;
    }

    .skills-textarea {
        min-height: 95px;
        padding: 13px 14px;
        resize: vertical;
    }

    .internship-input:focus {
        border-color: #0284c7;
        background: white;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.09);
    }

    .form-grid,
    .payment-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .dates-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
    }

    .section-divider {
        margin: 8px 0 23px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #0369a1;
        font-size: 12px;
        font-weight: 800;
    }

        .section-divider::before,
        .section-divider::after {
            content: "";
            height: 1px;
            flex: 1;
            background: #e2e8f0;
        }

    .paid-option {
        display: flex;
        align-items: center;
        min-height: 73px;
    }

    .switch-label {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
    }

        .switch-label input {
            display: none;
        }

    .custom-switch {
        width: 48px;
        height: 26px;
        flex-shrink: 0;
        border-radius: 20px;
        background: #cbd5e1;
        position: relative;
        transition: 0.3s;
    }

        .custom-switch::after {
            content: "";
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: white;
            position: absolute;
            top: 3px;
            left: 3px;
            transition: 0.3s;
        }

    .switch-label input:checked + .custom-switch {
        background: #10b981;
    }

        .switch-label input:checked +
        .custom-switch::after {
            left: 25px;
        }

    .switch-label strong,
    .switch-label small {
        display: block;
    }

    .switch-label strong {
        color: #334155;
        font-size: 12px;
    }

    .switch-label small {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
    }

    .salary-input-wrapper {
        position: relative;
    }

        .salary-input-wrapper input {
            padding-right: 60px;
        }

        .salary-input-wrapper > span {
            color: #64748b;
            position: absolute;
            right: 15px;
            top: 15px;
            font-size: 11px;
            font-weight: 700;
        }

    .approval-note {
        padding: 16px;
        margin-top: 5px;
        display: flex;
        gap: 12px;
        border: 1px solid #fde68a;
        border-radius: 14px;
        background: #fffbeb;
    }

        .approval-note > span {
            font-size: 23px;
        }

        .approval-note strong {
            color: #92400e;
            font-size: 12px;
        }

        .approval-note p {
            margin: 4px 0 0;
            color: #b45309;
            font-size: 10px;
        }

    .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 11px;
    }

    .form-actions {
        margin-top: 28px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .cancel-button,
    .save-button {
        padding: 11px 21px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        transition: 0.3s;
    }

    .cancel-button {
        color: #475569;
        border: 1px solid #dce3ed;
        background: white;
        text-decoration: none;
    }

    .save-button {
        color: white;
        border: none;
        background: linear-gradient(90deg, #0284c7, #7c3aed);
        box-shadow: 0 9px 22px rgba(2, 132, 199, 0.24);
    }

        .cancel-button:hover,
        .save-button:hover {
            transform: translateY(-2px);
        }

    @@keyframes formEntrance {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes editFloat {
        0%, 100% {
            transform: translateY(0) rotate(-5deg);
        }

        50% {
            transform: translateY(-9px) rotate(5deg);
        }
    }

    @@media (max-width: 750px) {
        .form-grid,
        .payment-grid,
        .dates-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-banner {
            padding: 30px 24px;
        }

        .banner-icon {
            display: none;
        }

        .internship-form-card {
            padding: 25px 18px;
        }

        .form-card-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const paidCheckbox =
            document.getElementById("paidCheckbox");

        const salaryGroup =
            document.getElementById("salaryGroup");

        function updateSalaryVisibility() {
            if (paidCheckbox.checked) {
                salaryGroup.style.display = "block";
            }
            else {
                salaryGroup.style.display = "none";
            }
        }

        paidCheckbox.addEventListener(
            "change",
            updateSalaryVisibility);

        updateSalaryVisibility();
    </script>
}