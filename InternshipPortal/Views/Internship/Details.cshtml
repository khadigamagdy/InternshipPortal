@model InternshipPortal.Models.Internship

@{
    ViewData["Title"] = "Internship Details";
}

<div class="details-page">
    <div class="details-container">

        @if (TempData["Error"] != null)
        {
            <div class="error-alert">
                <span>!</span>
                @TempData["Error"]
            </div>
        }

        <section class="details-header">
            <div class="company-logo">
                @if (!string.IsNullOrEmpty(Model.Company.LogoPath))
                {
                    <img src="@Model.Company.LogoPath"
                         alt="@Model.Company.Name" />
                }
                else
                {
                    <span>🏢</span>
                }
            </div>

            <div class="header-content">
                <div class="badges-row">
                    <span class="mode-badge">
                        @Model.WorkMode
                    </span>

                    @if (Model.IsApproved)
                    {
                        <span class="approved-badge">
                            ✓ Approved
                        </span>
                    }
                    else
                    {
                        <span class="pending-badge">
                            ⏳ Pending Approval
                        </span>
                    }

                    @if (Model.IsPaid)
                    {
                        <span class="paid-badge">
                            Paid Internship
                        </span>
                    }
                    else
                    {
                        <span class="unpaid-badge">
                            Unpaid Internship
                        </span>
                    }
                </div>

                <h1>@Model.Title</h1>

                <p class="company-name">
                    @Model.Company.Name
                </p>

                <div class="header-meta">
                    <span>📍 @Model.Location</span>

                    <span>
                        📅 Posted
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </span>

                    <span>
                        👥 @Model.AvailablePositions positions
                    </span>
                </div>
            </div>

            <div class="header-actions">
                @if (User.IsInRole("Company"))
                {
                    <a asp-controller="Internship"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="edit-header-button">
                        Edit Internship
                    </a>

                    <a asp-controller="Internship"
                       asp-action="MyInternships"
                       class="back-header-button">
                        ← My Internships
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin"
                       asp-action="PendingInternships"
                       class="back-header-button">
                        ← Review Internships
                    </a>
                }
                else
                {
                    <a asp-controller="Internship"
                       asp-action="Index"
                       class="back-header-button">
                        ← Browse Internships
                    </a>
                }
            </div>
        </section>

        <section class="details-grid">
            <main class="details-main">
                <article class="content-card">
                    <div class="card-heading">
                        <span class="heading-icon">📋</span>

                        <div>
                            <h2>Internship Description</h2>
                            <p>About this opportunity</p>
                        </div>
                    </div>

                    <div class="text-content">
                        @Model.Description
                    </div>
                </article>

                <article class="content-card">
                    <div class="card-heading">
                        <span class="heading-icon skills-icon">
                            🛠️
                        </span>

                        <div>
                            <h2>Required Skills</h2>
                            <p>Skills needed for this internship</p>
                        </div>
                    </div>

                    <div class="text-content">
                        @Model.RequiredSkills
                    </div>
                </article>

                <article class="content-card">
                    <div class="card-heading">
                        <span class="heading-icon company-icon">
                            🏢
                        </span>

                        <div>
                            <h2>About the Company</h2>
                            <p>Company information</p>
                        </div>
                    </div>

                    <div class="company-information">
                        <div class="company-information-top">
                            <div>
                                <h3>@Model.Company.Name</h3>

                                <span>
                                    📍 @Model.Company.Location
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(
                                Model.Company.Website))
                            {
                                <a href="@Model.Company.Website"
                                   target="_blank">
                                    Visit Website ↗
                                </a>
                            }
                        </div>

                        <p>@Model.Company.Description</p>
                    </div>
                </article>
            </main>

            <aside class="details-sidebar">
                <article class="overview-card">
                    <h2>Internship Overview</h2>

                    <div class="overview-item">
                        <span class="overview-icon">💻</span>

                        <div>
                            <small>Work Mode</small>
                            <strong>@Model.WorkMode</strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">📍</span>

                        <div>
                            <small>Location</small>
                            <strong>@Model.Location</strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">🗓️</span>

                        <div>
                            <small>Application Deadline</small>

                            <strong>
                                @Model.ApplicationDeadline
                                .ToString("dd MMMM yyyy")
                            </strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">🚀</span>

                        <div>
                            <small>Start Date</small>

                            <strong>
                                @Model.StartDate
                                .ToString("dd MMMM yyyy")
                            </strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">🏁</span>

                        <div>
                            <small>End Date</small>

                            <strong>
                                @Model.EndDate
                                .ToString("dd MMMM yyyy")
                            </strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">👥</span>

                        <div>
                            <small>Available Positions</small>

                            <strong>
                                @Model.AvailablePositions
                            </strong>
                        </div>
                    </div>

                    <div class="overview-item">
                        <span class="overview-icon">💰</span>

                        <div>
                            <small>Monthly Salary</small>

                            <strong>
                                @if (Model.IsPaid)
                                {
                                    <text>
                                        @Model.Salary?.ToString("N0")
                                        EGP
                                    </text>
                                }
                                else
                                {
                                    <text>Unpaid</text>
                                }
                            </strong>
                        </div>
                    </div>

                    @if (User.IsInRole("Student"))
                    {
                        @if (Model.ApplicationDeadline >= DateTime.Today &&
                             Model.IsApproved &&
                             Model.IsActive)
                        {
                            <div class="student-apply-section">
                                <div class="apply-message">
                                    <span>🎓</span>

                                    <div>
                                        <strong>
                                            Interested in this opportunity?
                                        </strong>

                                        <p>
                                            Apply before
                                            @Model.ApplicationDeadline
                                            .ToString("dd MMMM yyyy").
                                        </p>
                                    </div>
                                </div>

                                <a asp-controller="Application"
                                   asp-action="Apply"
                                   asp-route-internshipId="@Model.Id"
                                   class="apply-now-button">
                                    Apply Now →
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="closed-application">
                                <span>⏰</span>

                                <div>
                                    <strong>
                                        Applications Closed
                                    </strong>

                                    <p>
                                        Applications are no longer available.
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </article>

                <article class="deadline-card">
                    <span>⏰</span>

                    <div>
                        <small>Application closes on</small>

                        <strong>
                            @Model.ApplicationDeadline
                            .ToString("dd MMMM yyyy")
                        </strong>
                    </div>
                </article>
            </aside>
        </section>
    </div>
</div>

<style>
    .details-page {
        min-height: 100vh;
        padding: 40px 20px 70px;
        background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 30%), radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.07), transparent 35%), #f5f7fb;
    }

    .details-container {
        max-width: 1200px;
        margin: auto;
    }

    .error-alert {
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #b91c1c;
        border: 1px solid #fecaca;
        border-radius: 13px;
        background: #fef2f2;
        font-size: 12px;
        font-weight: 700;
    }

    .details-header {
        padding: 34px 38px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 22px;
        color: white;
        border-radius: 25px;
        background: linear-gradient(135deg, #0f2b5b, #1d4ed8 58%, #6d28d9);
        box-shadow: 0 20px 48px rgba(30, 64, 175, 0.21);
        animation: detailsEntrance 0.7s ease;
    }

    .company-logo {
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid rgba(255, 255, 255, 0.25);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.16);
    }

        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .company-logo > span {
            font-size: 44px;
        }

    .badges-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

        .badges-row > span {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 800;
        }

    .mode-badge {
        color: #1e3a8a;
        background: #dbeafe;
    }

    .approved-badge,
    .paid-badge {
        color: #047857;
        background: #d1fae5;
    }

    .pending-badge {
        color: #b45309;
        background: #fef3c7;
    }

    .unpaid-badge {
        color: #475569;
        background: #e2e8f0;
    }

    .details-header h1 {
        margin: 10px 0 3px;
        font-size: 28px;
        font-weight: 800;
    }

    .company-name {
        margin: 0;
        color: #bfdbfe;
        font-size: 14px;
        font-weight: 600;
    }

    .header-meta {
        margin-top: 13px;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        color: #dbeafe;
        font-size: 10px;
    }

    .header-actions {
        display: flex;
        align-items: flex-end;
        flex-direction: column;
        gap: 9px;
    }

    .edit-header-button,
    .back-header-button {
        padding: 9px 14px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: 0.3s;
    }

    .edit-header-button {
        color: #1e3a8a;
        background: white;
    }

    .back-header-button {
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

        .edit-header-button:hover,
        .back-header-button:hover {
            transform: translateY(-2px);
        }

    .details-grid {
        margin-top: 23px;
        display: grid;
        grid-template-columns: 1.6fr 0.8fr;
        gap: 22px;
        align-items: start;
    }

    .details-main {
        display: flex;
        flex-direction: column;
        gap: 19px;
    }

    .content-card,
    .overview-card,
    .deadline-card {
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        animation: detailsEntrance 0.8s ease;
    }

    .content-card {
        padding: 27px;
    }

    .card-heading {
        padding-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #eef2f7;
    }

    .heading-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #dbeafe;
        font-size: 22px;
    }

    .skills-icon {
        background: #ede9fe;
    }

    .company-icon {
        background: #d1fae5;
    }

    .card-heading h2 {
        margin: 0;
        color: #172554;
        font-size: 17px;
        font-weight: 800;
    }

    .card-heading p {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: 10px;
    }

    .text-content {
        padding-top: 19px;
        color: #475569;
        line-height: 1.9;
        white-space: pre-line;
        font-size: 12px;
    }

    .company-information {
        padding-top: 18px;
    }

    .company-information-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .company-information h3 {
        margin: 0;
        color: #334155;
        font-size: 15px;
        font-weight: 800;
    }

    .company-information span {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 10px;
    }

    .company-information a {
        padding: 8px 11px;
        color: #0369a1;
        border-radius: 9px;
        background: #e0f2fe;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .company-information > p {
        margin: 15px 0 0;
        color: #64748b;
        line-height: 1.8;
        font-size: 11px;
    }

    .details-sidebar {
        position: sticky;
        top: 20px;
    }

    .overview-card {
        padding: 25px;
    }

        .overview-card > h2 {
            margin: 0 0 20px;
            color: #172554;
            font-size: 17px;
            font-weight: 800;
        }

    .overview-item {
        padding: 13px 0;
        display: flex;
        align-items: center;
        gap: 11px;
        border-bottom: 1px solid #f1f5f9;
    }

    .overview-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f1f5f9;
        font-size: 18px;
    }

    .overview-item small,
    .overview-item strong {
        display: block;
    }

    .overview-item small {
        color: #94a3b8;
        font-size: 9px;
    }

    .overview-item strong {
        margin-top: 3px;
        color: #334155;
        font-size: 11px;
    }

    .student-apply-section {
        padding: 16px;
        margin-top: 18px;
        border-radius: 14px;
        background: linear-gradient(135deg, #eff6ff, #ecfdf5);
    }

    .apply-message {
        display: flex;
        gap: 10px;
    }

        .apply-message > span {
            font-size: 24px;
        }

        .apply-message strong {
            color: #1e3a8a;
            font-size: 11px;
        }

        .apply-message p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 9px;
        }

    .apply-now-button {
        display: block;
        padding: 11px;
        margin-top: 13px;
        color: white;
        border-radius: 10px;
        background: linear-gradient(90deg, #2563eb, #059669);
        text-align: center;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: 0.3s;
    }

        .apply-now-button:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
        }

    .closed-application {
        padding: 14px;
        margin-top: 18px;
        display: flex;
        gap: 10px;
        border-radius: 13px;
        background: #fef2f2;
    }

        .closed-application > span {
            font-size: 23px;
        }

        .closed-application strong {
            color: #b91c1c;
            font-size: 11px;
        }

        .closed-application p {
            margin: 3px 0 0;
            color: #dc2626;
            font-size: 9px;
        }

    .deadline-card {
        padding: 18px;
        margin-top: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-color: #fde68a;
        background: #fffbeb;
    }

        .deadline-card > span {
            font-size: 27px;
        }

        .deadline-card small,
        .deadline-card strong {
            display: block;
        }

        .deadline-card small {
            color: #b45309;
            font-size: 9px;
        }

        .deadline-card strong {
            margin-top: 4px;
            color: #92400e;
            font-size: 12px;
        }

    @@keyframes detailsEntrance {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 900px) {
        .details-header {
            grid-template-columns: auto 1fr;
        }

        .header-actions {
            grid-column: 1 / 3;
            align-items: flex-start;
            flex-direction: row;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .details-sidebar {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .details-header {
            padding: 28px 20px;
            grid-template-columns: 1fr;
        }

        .header-actions {
            grid-column: 1;
            flex-wrap: wrap;
        }

        .company-logo {
            width: 70px;
            height: 70px;
        }

        .company-information-top {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }
    }
</style>