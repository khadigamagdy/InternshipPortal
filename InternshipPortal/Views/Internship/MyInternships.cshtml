@model List<InternshipPortal.Models.Internship>

@{
    ViewData["Title"] = "My Internships";
}

<div class="internships-page">
    <div class="page-container">

        @if (TempData["Success"] != null)
        {
            <div class="alert success-alert">
                ✓ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert error-alert">
                ! @TempData["Error"]
            </div>
        }

        <section class="page-header">
            <div>
                <span class="header-badge">
                    Company Opportunities
                </span>

                <h1>My Internships</h1>

                <p>
                    Create, update and manage your
                    internship opportunities and applicants.
                </p>
            </div>

            <a asp-controller="Internship"
               asp-action="Create"
               class="add-button">
                + Add New Internship
            </a>
        </section>

        <section class="statistics-grid">
            <div class="stat-card">
                <span class="stat-icon blue-icon">💼</span>

                <div>
                    <strong>@Model.Count</strong>
                    <small>Total Internships</small>
                </div>
            </div>

            <div class="stat-card">
                <span class="stat-icon green-icon">✓</span>

                <div>
                    <strong>
                        @Model.Count(i => i.IsApproved)
                    </strong>

                    <small>Approved</small>
                </div>
            </div>

            <div class="stat-card">
                <span class="stat-icon orange-icon">⏳</span>

                <div>
                    <strong>
                        @Model.Count(i =>
                            !i.IsApproved && i.IsActive)
                    </strong>

                    <small>Pending Approval</small>
                </div>
            </div>

            <div class="stat-card">
                <span class="stat-icon red-icon">✕</span>

                <div>
                    <strong>
                        @Model.Count(i => !i.IsActive)
                    </strong>

                    <small>Inactive or Rejected</small>
                </div>
            </div>
        </section>

        @if (Model.Any())
        {
            <section class="internships-list">
                @foreach (var internship in Model)
                {
                    <article class="internship-card">
                        <div class="card-header">
                            <div class="internship-icon">
                                💻
                            </div>

                            <div class="internship-title">
                                <div class="status-row">
                                    @if (internship.IsApproved &&
                                         internship.IsActive)
                                    {
                                        <span class="status approved">
                                            Approved
                                        </span>
                                    }
                                    else if (!internship.IsApproved &&
                                             internship.IsActive)
                                    {
                                        <span class="status pending">
                                            Pending Approval
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status rejected">
                                            Rejected or Inactive
                                        </span>
                                    }

                                    <span class="status work-mode">
                                        @internship.WorkMode
                                    </span>
                                </div>

                                <h2>@internship.Title</h2>

                                <p>@internship.Description</p>
                            </div>
                        </div>

                        <div class="information-grid">
                            <div>
                                <span>📍</span>

                                <small>Location</small>

                                <strong>
                                    @internship.Location
                                </strong>
                            </div>

                            <div>
                                <span>👥</span>

                                <small>Positions</small>

                                <strong>
                                    @internship.AvailablePositions
                                </strong>
                            </div>

                            <div>
                                <span>📅</span>

                                <small>Deadline</small>

                                <strong>
                                    @internship.ApplicationDeadline
                                    .ToString("dd MMM yyyy")
                                </strong>
                            </div>

                            <div>
                                <span>💰</span>

                                <small>Payment</small>

                                <strong>
                                    @if (internship.IsPaid)
                                    {
                                        <text>
                                            @internship.Salary?
                                            .ToString("N0")
                                            EGP
                                        </text>
                                    }
                                    else
                                    {
                                        <text>Unpaid</text>
                                    }
                                </strong>
                            </div>
                        </div>

                        <div class="skills-box">
                            <strong>Required Skills</strong>
                            <p>@internship.RequiredSkills</p>
                        </div>

                        <div class="card-footer">
                            <span class="created-date">
                                Created
                                @internship.CreatedAt
                                .ToString("dd MMM yyyy")
                            </span>

                            <div class="action-buttons">
                                <a asp-controller="Application"
                                   asp-action="Applicants"
                                   asp-route-internshipId="@internship.Id"
                                   class="action-button applicants-button">
                                    Applicants
                                </a>

                                <a asp-controller="Internship"
                                   asp-action="Details"
                                   asp-route-id="@internship.Id"
                                   class="action-button details-button">
                                    Details
                                </a>

                                <a asp-controller="Internship"
                                   asp-action="Edit"
                                   asp-route-id="@internship.Id"
                                   class="action-button edit-button">
                                    Edit
                                </a>

                                <a asp-controller="Internship"
                                   asp-action="Delete"
                                   asp-route-id="@internship.Id"
                                   class="action-button delete-button">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="empty-state">
                <div class="empty-icon">💼</div>

                <h2>No Internships Yet</h2>

                <p>
                    Create your first internship opportunity
                    and start receiving student applications.
                </p>

                <a asp-controller="Internship"
                   asp-action="Create">
                    Create First Internship
                </a>
            </section>
        }
    </div>
</div>

<style>
    .internships-page {
        min-height: 100vh;
        padding: 40px 20px 70px;
        background: radial-gradient(circle at top left, rgba(2, 132, 199, 0.09), transparent 30%), radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.08), transparent 35%), #f5f7fb;
    }

    .page-container {
        max-width: 1200px;
        margin: auto;
    }

    .alert {
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .success-alert {
        color: #047857;
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
    }

    .error-alert {
        color: #b91c1c;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .page-header {
        padding: 36px 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white;
        border-radius: 25px;
        background: linear-gradient(135deg, #082f49, #0369a1 55%, #6d28d9);
        box-shadow: 0 20px 45px rgba(3, 105, 161, 0.2);
        animation: pageEntrance 0.7s ease;
    }

    .header-badge {
        display: inline-block;
        padding: 5px 12px;
        margin-bottom: 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.16);
        font-size: 10px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 800;
    }

    .page-header p {
        margin: 9px 0 0;
        color: #e0f2fe;
        font-size: 12px;
    }

    .add-button {
        padding: 11px 18px;
        color: #075985;
        border-radius: 11px;
        background: white;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: 0.3s;
    }

        .add-button:hover {
            color: #075985;
            transform: translateY(-3px);
        }

    .statistics-grid {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .stat-card {
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        background: white;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 22px;
    }

    .blue-icon {
        background: #dbeafe;
    }

    .green-icon {
        background: #d1fae5;
    }

    .orange-icon {
        background: #fef3c7;
    }

    .red-icon {
        background: #fee2e2;
    }

    .stat-card strong,
    .stat-card small {
        display: block;
    }

    .stat-card strong {
        color: #172554;
        font-size: 20px;
        font-weight: 800;
    }

    .stat-card small {
        color: #64748b;
        font-size: 8px;
    }

    .internships-list {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .internship-card {
        padding: 24px;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        transition: 0.35s;
        animation: pageEntrance 0.8s ease;
    }

        .internship-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 37px rgba(30, 64, 175, 0.1);
        }

    .card-header {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: start;
        gap: 15px;
    }

    .internship-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: linear-gradient(135deg, #dbeafe, #ede9fe);
        font-size: 28px;
    }

    .status-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .status {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 800;
    }

    .approved {
        color: #047857;
        background: #d1fae5;
    }

    .pending {
        color: #b45309;
        background: #fef3c7;
    }

    .rejected {
        color: #b91c1c;
        background: #fee2e2;
    }

    .work-mode {
        color: #6d28d9;
        background: #ede9fe;
    }

    .internship-title h2 {
        margin: 8px 0 5px;
        color: #172554;
        font-size: 19px;
        font-weight: 800;
    }

    .internship-title > p {
        margin: 0;
        color: #64748b;
        line-height: 1.7;
        font-size: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .information-grid {
        padding: 17px 0;
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid #eef2f7;
        border-bottom: 1px solid #eef2f7;
    }

        .information-grid > div {
            padding: 0 13px;
            display: grid;
            grid-template-columns: auto 1fr;
            column-gap: 8px;
            border-right: 1px solid #eef2f7;
        }

            .information-grid > div:last-child {
                border-right: none;
            }

            .information-grid > div > span {
                grid-row: 1 / 3;
                align-self: center;
                font-size: 20px;
            }

        .information-grid small,
        .information-grid strong {
            display: block;
        }

        .information-grid small {
            color: #94a3b8;
            font-size: 8px;
        }

        .information-grid strong {
            margin-top: 3px;
            color: #334155;
            font-size: 10px;
        }

    .skills-box {
        padding: 12px 14px;
        margin-top: 14px;
        border-radius: 11px;
        background: #f8fafc;
    }

        .skills-box strong {
            color: #334155;
            font-size: 9px;
        }

        .skills-box p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 9px;
        }

    .card-footer {
        margin-top: 17px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .created-date {
        color: #94a3b8;
        font-size: 8px;
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .action-button {
        padding: 7px 11px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 8px;
        font-weight: 800;
        transition: 0.3s;
    }

    .applicants-button {
        color: #6d28d9;
        background: #ede9fe;
    }

    .details-button {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .edit-button {
        color: #047857;
        background: #d1fae5;
    }

    .delete-button {
        color: #b91c1c;
        background: #fee2e2;
    }

    .action-button:hover {
        transform: translateY(-2px);
    }

    .empty-state {
        padding: 70px 20px;
        margin-top: 20px;
        text-align: center;
        border: 2px dashed #bae6fd;
        border-radius: 21px;
        background: white;
    }

    .empty-icon {
        font-size: 44px;
    }

    .empty-state h2 {
        margin: 16px 0 6px;
        color: #172554;
        font-size: 20px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 10px;
    }

    .empty-state a {
        display: inline-block;
        padding: 10px 15px;
        margin-top: 12px;
        color: white;
        border-radius: 9px;
        background: linear-gradient(90deg, #0284c7, #7c3aed);
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
    }

    @@keyframes pageEntrance {
        from {
            opacity: 0;
            transform: translateY(17px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 850px) {
        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .information-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px 0;
        }
    }

    @@media (max-width: 600px) {
        .page-header {
            padding: 30px 22px;
            align-items: flex-start;
            flex-direction: column;
            gap: 17px;
        }

        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .information-grid {
            grid-template-columns: 1fr;
        }

            .information-grid > div {
                border-right: none;
            }

        .card-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 13px;
        }
    }
</style>